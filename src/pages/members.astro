---
/**
 * /members — 會員專區（作品集）。
 *
 * 混合 SEO 策略:
 * - 標題 + 摘要(excerpt)在 build 時從 Worker /members/posts 抓,渲染進靜態 HTML → Google 爬得到
 * - 全文鎖在 D1,只有登入後 MemberGate island 帶 JWT 才拿得到 → 全文「不在」HTML
 *
 * 後端沒上線時 fetchPublicPosts 回空陣列,頁面照 build 不掛(顯示「即將上線」)。
 */
import RootLayout from '../layouts/RootLayout.astro';
import NavbarNeub from '../components/NavbarNeub.astro';
import FooterNeub from '../components/FooterNeub.astro';
import MemberGate from '../components/MemberGate.tsx';
import { fetchPublicPosts } from '../lib/members-api';

const posts = await fetchPublicPosts();
const formatDate = (ms: number) =>
  new Date(ms).toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<RootLayout
  title="會員專區 — 作品集 | AI 講師陳彥彤YC"
  description="陳彥彤的自寫作品集:會議即時逐字稿 AI 副駕 letsMeet、OCR 自動填表、各式小工具。摘要公開,登入看完整架構拆解與踩坑紀錄。"
  canonical="/members"
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <section class="px-6 md:px-10 py-12 border-b-2 border-black bg-white">
      <div class="max-w-4xl mx-auto">
        <div
          class="inline-block px-2 py-1 mb-4 text-xs uppercase tracking-widest border-2 border-black font-black bg-[var(--color-neub-yellow)] font-mono"
        >
          members · portfolio
        </div>
        <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-3">作品專區</h1>
        <p class="text-sm md:text-base opacity-70 leading-relaxed max-w-2xl">
          我自己寫過、跑過的小作品 — 從會議 AI 副駕到自動化工具。每篇都有摘要,
          想看完整的架構拆解、實作細節和踩坑紀錄,免費註冊登入就解鎖。
        </p>
      </div>
    </section>

    <section class="px-6 md:px-10 py-12 bg-[#FAFAFA]">
      <div class="max-w-4xl mx-auto space-y-16">
        {
          posts.length === 0 ? (
            <div class="border-2 border-dashed border-black p-12 text-center bg-white">
              <div class="text-4xl mb-3">🛠️</div>
              <p class="text-base font-bold">作品專區即將上線</p>
              <p class="text-sm opacity-60 mt-1 font-mono">first post coming soon</p>
            </div>
          ) : (
            posts.map((post) => (
              <article class="border-2 border-black bg-white p-6 md:p-10" style="box-shadow: 8px 8px 0 #0a0a0a">
                {/* 公開封面圖(吃 SEO 勾子;細節截圖留鎖文) */}
                {post.cover && (
                  <img
                    src={post.cover}
                    alt={post.title}
                    loading="lazy"
                    class="w-full border-2 border-black mb-6"
                    style="box-shadow: 4px 4px 0 #0a0a0a; aspect-ratio: 16 / 9; object-fit: cover;"
                  />
                )}
                {/* 公開部分:標題 + 摘要(吃 SEO) */}
                <div class="mb-2 text-[11px] uppercase tracking-widest font-mono opacity-50">
                  {formatDate(post.created_at)}
                  {post.tags ? ` · ${post.tags}` : ''}
                </div>
                <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-4">{post.title}</h2>
                <p class="text-sm md:text-base leading-relaxed opacity-90 mb-8">{post.excerpt}</p>

                {/* 鎖的部分:全文不在 HTML,由 island 登入後動態抓 */}
                <MemberGate client:visible slug={post.slug} title={post.title} />
              </article>
            ))
          )
        }
      </div>
    </section>
  </main>

  <FooterNeub />
</RootLayout>

<style is:global>
  /* 會員全文(mini-markdown 產的 HTML)排版 */
  .member-content h1 { font-size: 1.75rem; font-weight: 900; margin: 1.5rem 0 0.75rem; }
  .member-content h2 { font-size: 1.4rem; font-weight: 900; margin: 1.5rem 0 0.75rem; border-bottom: 2px solid #0a0a0a; padding-bottom: 0.25rem; }
  .member-content h3 { font-size: 1.15rem; font-weight: 800; margin: 1.25rem 0 0.5rem; }
  .member-content p { margin: 0.85rem 0; line-height: 1.75; }
  .member-content ul { margin: 0.85rem 0; padding-left: 1.5rem; list-style: disc; }
  .member-content li { margin: 0.35rem 0; line-height: 1.7; }
  .member-content a { text-decoration: underline; font-weight: 600; }
  .member-content strong { font-weight: 800; }
  .member-content code { background: #f0f0eb; border: 1px solid #d4d4d0; padding: 0.1em 0.35em; font-size: 0.875em; font-family: ui-monospace, monospace; }
  .member-content pre { background: #0a0a0a; color: #f5f5f0; padding: 1rem 1.25rem; overflow-x: auto; margin: 1.25rem 0; border: 2px solid #0a0a0a; }
  .member-content pre code { background: none; border: none; color: inherit; padding: 0; }
  .member-content img { max-width: 100%; height: auto; border: 2px solid #0a0a0a; margin: 1.25rem 0; box-shadow: 5px 5px 0 #0a0a0a; }
  .member-content table { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-size: 0.9rem; }
  .member-content th, .member-content td { border: 1px solid #0a0a0a; padding: 0.5rem 0.75rem; text-align: left; }
  .member-content th { background: var(--color-neub-yellow); font-weight: 800; }
</style>
