---
/**
 * /blog/k8s/[slug] — K8s 系列單篇文章頁。
 *
 * 重用 /blog/[slug] 的版面與互動腳本（TOC、copy 按鈕、scroll hint），
 * 但資料來源是 lib/k8s（純靜態 K8sLesson），且加上「上一課/下一課」導覽。
 */
import RootLayout from '../../../layouts/RootLayout.astro';
import NavbarNeub from '../../../components/NavbarNeub.astro';
import FooterNeub from '../../../components/FooterNeub.astro';
import ReadingProgress from '../../../components/ReadingProgress.astro';
import {
  getAllK8sLessons,
  getAdjacentLessons,
  groupMeta,
  type K8sLesson,
} from '../../../lib/k8s';
import { renderMarkdown, inlineKrokiImages } from '../../../lib/markdown';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const lessons = getAllK8sLessons();
  return lessons.map((lesson) => ({
    params: { slug: lesson.slug },
    props: { lesson },
  }));
}

interface Props {
  lesson: K8sLesson;
}

const { lesson } = Astro.props;
const { html: rawHtml, toc } = renderMarkdown(lesson.content);
const html = await inlineKrokiImages(rawHtml);
const { prev, next } = getAdjacentLessons(lesson.slug);
const group = groupMeta[lesson.group];

const formatDate = (d: string) => d.replaceAll('-', '/');
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (p: string) => `${siteOrigin}${withBase(p)}`;

const lessonUrl = absoluteUrl(`/blog/k8s/${lesson.slug}`);
const homeUrl = absoluteUrl('/');
const blogUrl = absoluteUrl('/blog');

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: lesson.title,
  description: lesson.excerpt,
  url: lessonUrl,
  datePublished: lesson.publishDate,
  dateModified: lesson.updateDate ?? lesson.publishDate,
  author: { '@type': 'Person', name: '陳彥彤', url: homeUrl },
  publisher: {
    '@type': 'Organization',
    name: 'AI 講師陳彥彤YC',
    url: homeUrl,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': lessonUrl },
  keywords: lesson.tags.join(', '),
  articleSection: `Kubernetes - ${group.label}`,
  wordCount: lesson.content.length,
  inLanguage: 'zh-Hant',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: '部落格', item: blogUrl },
    { '@type': 'ListItem', position: 3, name: 'Kubernetes 教學', item: absoluteUrl('/blog#k8s') },
    { '@type': 'ListItem', position: 4, name: lesson.title, item: lessonUrl },
  ],
};
---

<RootLayout
  title={`${lesson.title} | Kubernetes 完整教學`}
  description={lesson.excerpt}
  canonical={`/blog/k8s/${lesson.slug}`}
  jsonLd={[blogPostingSchema, breadcrumbSchema]}
>
  <ReadingProgress />
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <!-- Breadcrumb -->
    <nav
      class="px-6 md:px-10 py-3 border-b-2 border-black text-xs uppercase tracking-widest font-mono"
      aria-label="breadcrumb"
    >
      <div class="max-w-5xl mx-auto flex items-center gap-2 opacity-70 min-w-0">
        <a href={withBase('/')} class="hover:bg-[#ffff00] px-1 shrink-0">home</a>
        <span class="shrink-0">/</span>
        <a href={withBase('/blog')} class="hover:bg-[#ffff00] px-1 shrink-0">blog</a>
        <span class="shrink-0">/</span>
        <a href={withBase('/blog#k8s')} class="hover:bg-[#ffff00] px-1 shrink-0">k8s</a>
        <span class="shrink-0">/</span>
        <span class="font-black opacity-100 truncate min-w-0">{lesson.title}</span>
      </div>
    </nav>

    <!-- Header -->
    <header class="px-6 md:px-10 py-12 border-b-2 border-black bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-xs uppercase tracking-widest mb-4 opacity-70 flex flex-wrap items-center gap-2 font-mono">
          <span
            class="font-black px-2 py-0.5 border-2 border-black"
            style={`background: ${group.color};`}
          >
            K8s · {group.label}
          </span>
          <span>·</span>
          <span class="font-black">第 {lesson.order.toString().padStart(2, '0')} 課</span>
          <span>·</span>
          <time datetime={lesson.publishDate}>{formatDate(lesson.publishDate)}</time>
          <span>·</span>
          <span>{lesson.readingTime}min read</span>
        </div>

        <h1
          class="text-3xl md:text-5xl font-black leading-tight tracking-tight mb-6"
        >
          {lesson.title}
        </h1>

        <p class="text-base md:text-lg leading-relaxed opacity-80 max-w-3xl">
          {lesson.excerpt}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-2 font-mono">
          <div class="flex flex-wrap gap-2">
            {lesson.tags.map((tag) => (
              <span class="text-xs border-2 border-black px-2.5 py-1 leading-none">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- TOC + Content -->
    <div class="px-6 md:px-10 py-14">
      <div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-[220px_1fr]">
        {
          toc.length > 0 && (
            <>
              <details open class="lg:hidden border-2 border-black bg-white min-w-0">
                <summary class="cursor-pointer list-none px-4 py-3 flex items-center justify-between font-mono text-xs uppercase tracking-widest font-black bg-[var(--color-neub-yellow)] border-b-2 border-black">
                  <span>章節目錄 · {toc.length}</span>
                  <span aria-hidden="true">▾</span>
                </summary>
                <ul class="border-t-2 border-black text-xs font-mono">
                  {toc.map((item) => (
                    <li class="border-b border-black/10 last:border-b-0">
                      <a
                        href={`#${item.id}`}
                        data-toc-link={item.id}
                        class="block px-4 py-2 opacity-80 hover:bg-[#ffff00] leading-snug"
                      >
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>

              <aside class="hidden lg:block">
                <div class="sticky top-24 text-xs font-mono">
                  <div class="uppercase tracking-widest font-black mb-3 opacity-60">
                    目錄
                  </div>
                  <ul class="space-y-1 border-l-2 border-black/10">
                    {toc.map((item) => (
                      <li>
                        <a
                          href={`#${item.id}`}
                          data-toc-link={item.id}
                          class="toc-link block pl-3 -ml-[2px] py-1 opacity-70 hover:opacity-100 hover:bg-[#ffff00] leading-snug transition-all"
                        >
                          {item.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </aside>
            </>
          )
        }

        <article data-blog-prose class="blog-prose min-w-0" set:html={html} />
      </div>
    </div>

    <style is:global>
      .toc-link.is-active {
        opacity: 1;
        font-weight: 900;
        background: #ffeb3b;
        border-left: 2px solid #0a0a0a;
        margin-left: -2px;
        padding-left: 0.75rem;
      }
    </style>

    <script is:inline>
      (function () {
        function init() {
          const links = document.querySelectorAll('[data-toc-link]');
          if (!links.length) return;
          const map = new Map();
          links.forEach((a) => {
            const id = a.getAttribute('data-toc-link');
            const target = document.getElementById(id);
            if (target) map.set(id, { link: a, target });
          });
          if (!map.size) return;

          const setActive = (id) => {
            map.forEach((v, key) => {
              v.link.classList.toggle('is-active', key === id);
            });
          };

          const io = new IntersectionObserver(
            (entries) => {
              const visible = entries
                .filter((e) => e.isIntersecting)
                .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
              if (visible[0]) setActive(visible[0].target.id);
            },
            { rootMargin: '-100px 0px -60% 0px', threshold: [0, 1] },
          );
          map.forEach((v) => io.observe(v.target));
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>

    <!-- Prism.js syntax highlighting -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css"
    />
    <script is:inline src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-core.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>

    <script is:inline>
      /* 程式碼區塊：filename header + copy 按鈕 */
      (function () {
        function init() {
          const pres = document.querySelectorAll('article.blog-prose pre[data-lang]');
          pres.forEach((pre) => {
            if (pre.dataset.codeEnhanced) return;
            pre.dataset.codeEnhanced = '1';
            const lang = pre.dataset.lang || 'code';
            const filename = pre.dataset.filename || '';
            const label = filename || lang;
            const wrap = document.createElement('div');
            wrap.className = 'code-block';
            pre.parentNode.insertBefore(wrap, pre);
            wrap.appendChild(pre);
            const header = document.createElement('div');
            header.className = 'code-block-header';
            const labelEl = document.createElement('span');
            labelEl.className = 'code-block-label';
            labelEl.textContent = label;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'code-block-copy';
            btn.setAttribute('aria-label', '複製程式碼');
            btn.textContent = 'copy';
            btn.addEventListener('click', async () => {
              const code = pre.querySelector('code')?.innerText ?? '';
              try {
                await navigator.clipboard.writeText(code);
                btn.textContent = 'copied ✓';
                btn.classList.add('is-copied');
                setTimeout(() => {
                  btn.textContent = 'copy';
                  btn.classList.remove('is-copied');
                }, 1600);
              } catch {
                btn.textContent = 'failed';
                setTimeout(() => (btn.textContent = 'copy'), 1600);
              }
            });
            header.appendChild(labelEl);
            header.appendChild(btn);
            wrap.insertBefore(header, pre);
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>

    <script is:inline>
      /* 表格 / pre 橫向 overflow 提示 */
      (function () {
        const LABELS = {
          table: { idle: '← 左右滑動看完整表格 →', end: '← 滑回表格開頭' },
          pre: { idle: '← 左右滑動看程式碼 →', end: '← 回到程式碼開頭' },
        };
        function decorate() {
          const targets = document.querySelectorAll('article.blog-prose table, article.blog-prose pre');
          targets.forEach((el) => {
            if (el.dataset.scrollHinted) return;
            if (el.scrollWidth <= el.clientWidth + 1) return;
            const kind = el.tagName === 'TABLE' ? 'table' : 'pre';
            const labels = LABELS[kind];
            const hint = document.createElement('div');
            hint.className = 'scroll-hint';
            hint.setAttribute('aria-hidden', 'true');
            hint.textContent = labels.idle;
            const anchor = el.closest('.code-block') || el;
            anchor.parentNode.insertBefore(hint, anchor);
            el.dataset.scrollHinted = '1';
            const update = () => {
              const atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 2;
              hint.classList.toggle('at-end', atEnd);
              hint.textContent = atEnd ? labels.end : labels.idle;
            };
            update();
            el.addEventListener('scroll', update, { passive: true });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', decorate);
        } else {
          decorate();
        }
        window.addEventListener('resize', decorate, { passive: true });
      })();
    </script>

    <!-- Prev / Next -->
    <section class="px-6 md:px-10 py-12 border-t-2 border-black bg-white">
      <div class="max-w-5xl mx-auto grid gap-4 md:grid-cols-2">
        {prev ? (
          <a
            href={withBase(`/blog/k8s/${prev.slug}`)}
            class="block border-2 border-black p-5 hover:bg-[#ffff00] transition-colors"
          >
            <div class="text-xs uppercase tracking-widest opacity-60 mb-2 font-mono">
              ← 上一課 · 第 {prev.order.toString().padStart(2, '0')} 課
            </div>
            <div class="font-black leading-tight">{prev.title}</div>
          </a>
        ) : (
          <div class="border-2 border-dashed border-black/30 p-5 text-xs uppercase tracking-widest opacity-50 font-mono">
            這是第一課
          </div>
        )}
        {next ? (
          <a
            href={withBase(`/blog/k8s/${next.slug}`)}
            class="block border-2 border-black p-5 hover:bg-[#ffff00] transition-colors text-right"
          >
            <div class="text-xs uppercase tracking-widest opacity-60 mb-2 font-mono">
              下一課 · 第 {next.order.toString().padStart(2, '0')} 課 →
            </div>
            <div class="font-black leading-tight">{next.title}</div>
          </a>
        ) : (
          <div class="border-2 border-dashed border-black/30 p-5 text-xs uppercase tracking-widest opacity-50 font-mono text-right">
            目前最後一課（更新中）
          </div>
        )}
      </div>
    </section>

    <!-- 回 K8s 系列總覽 -->
    <section class="px-6 md:px-10 py-8 border-t-2 border-black">
      <div class="max-w-5xl mx-auto text-center">
        <a
          href={withBase('/blog#k8s')}
          class="inline-block px-4 py-2 text-xs uppercase tracking-widest border-2 border-black hover:bg-[#ffff00] font-mono"
        >
          ← 回 Kubernetes 完整教學目錄
        </a>
      </div>
    </section>
  </main>

  <FooterNeub />

  <div id="__post_meta" data-slug={`k8s/${lesson.slug}`} data-title={lesson.title} hidden></div>
  <script>
    import { trackPostView } from '../../../lib/firebase-client';
    const el = document.getElementById('__post_meta') as HTMLElement | null;
    const slug = el?.dataset.slug ?? '';
    const title = el?.dataset.title ?? '';
    if (slug) {
      const fire = () => { void trackPostView(slug, title); };
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(fire, { timeout: 2000 });
      } else {
        setTimeout(fire, 1200);
      }
    }
  </script>
</RootLayout>
