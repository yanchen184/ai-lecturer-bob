---
/**
 * /blog/topics — 所有 topic landing pages 的索引
 */
import RootLayout from '../../../layouts/RootLayout.astro';
import NavbarNeub from '../../../components/NavbarNeub.astro';
import FooterNeub from '../../../components/FooterNeub.astro';
import { topics } from '../../../lib/topics';
import { withBase } from '../../../lib/url';

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (p: string) => `${siteOrigin}${withBase(p)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '主題索引',
  description: '依關鍵字主題整理的文章入口頁',
  url: absoluteUrl('/blog/topics'),
  inLanguage: 'zh-Hant',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: topics.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absoluteUrl(`/blog/topics/${t.slug}`),
      name: t.title,
    })),
  },
};
---

<RootLayout
  title="主題索引 — AI 工具、知識管理、本地 LLM 完整教學"
  description="依關鍵字主題整理的文章入口：手機本地 LLM、LLM Wiki、MemPalace。每個主題彙整相關文章、實測筆記、踩坑、FAQ。"
  canonical="/blog/topics"
  jsonLd={jsonLd}
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <nav
      class="px-6 md:px-10 py-3 border-b-2 border-black text-xs uppercase tracking-widest font-mono"
      aria-label="breadcrumb"
    >
      <div class="max-w-5xl mx-auto flex items-center gap-2 opacity-70">
        <a href={withBase('/')} class="hover:bg-[#ffff00] px-1">home</a>
        <span>/</span>
        <a href={withBase('/blog')} class="hover:bg-[#ffff00] px-1">blog</a>
        <span>/</span>
        <span class="font-black opacity-100">topics</span>
      </div>
    </nav>

    <header class="px-6 md:px-10 py-12 border-b-2 border-black bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-xs uppercase tracking-widest font-mono opacity-60 mb-3">
          Topic Index · 主題索引
        </div>
        <h1 class="text-4xl md:text-6xl font-black leading-tight tracking-tight mb-4">
          依主題找文章
        </h1>
        <p class="text-base md:text-lg leading-relaxed opacity-80 max-w-3xl">
          按關鍵字整理的入口頁。每個主題彙整相關文章、實測筆記、踩坑紀錄、FAQ。
          如果你是從 Google 搜「手機本地 LLM」「LLM Wiki」「MemPalace」進來，這裡是你要的。
        </p>
      </div>
    </header>

    <section class="px-6 md:px-10 py-12">
      <div class="max-w-5xl mx-auto grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {topics.map((t) => (
          <a
            href={withBase(`/blog/topics/${t.slug}`)}
            class="block border-2 border-black bg-white p-6 hover:bg-[#ffff00] hover:-translate-x-1 hover:-translate-y-1 hover:[box-shadow:4px_4px_0_#0a0a0a] transition-all"
          >
            <div class="text-xs uppercase tracking-widest font-mono opacity-60 mb-3">
              Topic Hub
            </div>
            <h2 class="font-black text-xl md:text-2xl tracking-tight mb-3 leading-tight">
              {t.title}
            </h2>
            <p class="text-sm leading-relaxed opacity-80 mb-4 line-clamp-3">
              {t.metaDescription}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {t.keywords.slice(0, 3).map((k) => (
                <span class="px-2 py-0.5 text-[10px] uppercase tracking-widest font-mono border border-black/40">
                  {k}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <FooterNeub />
</RootLayout>
