---
/**
 * /blog — 部落格列表（Maggie Appleton Garden 風格）
 *
 * 設計取向：
 * - 暖米色 cream 背景 + Crimson Pro serif + 莓紅 accent
 * - Featured hero（最多人讀）+ 細線分隔列表
 * - K8s 系列折疊到底部，與主列表視覺區隔
 * - 無厚陰影、無粗黑邊、無黃色高亮
 *
 * SSR 出完整列表（SEO），搜尋 / 篩選由 BlogFilters island 控 DOM。
 */
import RootLayout from '../../layouts/RootLayout.astro';
import NavbarNeub from '../../components/NavbarNeub.astro';
import FooterNeub from '../../components/FooterNeub.astro';
import BlogFilters from '../../components/BlogFilters.tsx';
import BlogCardListItem from '../../components/BlogCardListItem.astro';
import BlogFeaturedHero from '../../components/BlogFeaturedHero.astro';
import { getAllPublishedPosts, getTopViewedSlugs } from '../../lib/firestore';
import { getAllK8sLessons, groupMeta, type K8sLesson } from '../../lib/k8s';
import { withBase } from '../../lib/url';

const posts = await getAllPublishedPosts();

const categories = [...new Set(posts.map((p) => p.category))];
const tags = [...new Set(posts.flatMap((p) => p.tags))];

// Hero 取點閱最高，沒資料退回 featured
const topSlugs = await getTopViewedSlugs();
const heroPost =
  topSlugs.map((slug) => posts.find((p) => p.slug === slug)).find(Boolean) ??
  posts.find((p) => p.featured);

// 列表排除 hero post（避免重複顯示）
const listPosts = heroPost ? posts.filter((p) => p.slug !== heroPost.slug) : posts;

// K8s 系列分組
const k8sLessons = getAllK8sLessons();
const k8sByGroup = (Object.keys(groupMeta) as Array<K8sLesson['group']>)
  .sort((a, b) => groupMeta[a].order - groupMeta[b].order)
  .map((g) => ({
    key: g,
    meta: groupMeta[g],
    lessons: k8sLessons.filter((l) => l.group === g),
  }))
  .filter((g) => g.lessons.length > 0);

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (p: string) => `${siteOrigin}${withBase(p)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: '陳彥彤 YC · AI 顧問 — 部落格',
  description: 'AI 工程師 + Java 後端的技術實戰筆記',
  url: absoluteUrl('/blog'),
  blogPost: posts.slice(0, 10).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.title,
    url: absoluteUrl(`/blog/${p.slug}`),
    datePublished: p.publishDate,
    author: { '@type': 'Person', name: p.author },
  })),
};
---

<RootLayout
  title="部落格 — 陳彥彤 YC · AI 顧問"
  description="AI 工程師 + Java 後端的技術筆記。LLM、RAG、Agent 導入心得；Spring Boot、React、MySQL、Redis、雲端踩坑紀錄；企業內訓現場觀察。"
  canonical="/blog"
  jsonLd={jsonLd}
>
  <NavbarNeub />

  <main class="garden-page">
    <div class="max-w-4xl mx-auto px-6 md:px-8 py-16 md:py-20">
      <!-- Header -->
      <header class="mb-2">
        <div class="garden-eyebrow" style="margin-bottom: 0.75rem;">
          The Bob Post · 後端踩坑筆記 + 教學現場
        </div>
        <h1 style="font-size: clamp(2.5rem, 6vw, 4rem); line-height: 1.05; font-weight: 500; letter-spacing: -0.02em; margin: 0;">
          部落格
        </h1>
        <p style="font-family: var(--font-garden-serif); font-size: 1.125rem; line-height: 1.6; color: var(--color-garden-ink-soft); margin: 1rem 0 0; max-width: 52ch;">
          AI 工程師 + Java 後端的技術筆記。LLM / RAG / Agent 導入、Spring Boot、雲端踩坑、教學現場觀察。共
          <span style="color: var(--color-garden-crimson); font-weight: 600;">{posts.length}</span> 篇。
        </p>
      </header>

      <!-- Featured hero -->
      {heroPost && <BlogFeaturedHero post={heroPost} />}

      <!-- Filters -->
      <div class="garden-filter">
        <BlogFilters
          client:load
          categories={categories}
          tags={tags}
          totalPosts={posts.length}
        />
      </div>

      <!-- All posts -->
      <section>
        <div class="garden-eyebrow" style="margin-bottom: 0.5rem;">全部文章</div>
        <div class="garden-list">
          {listPosts.map((post) => (
            <BlogCardListItem post={post} />
          ))}
        </div>

        <div
          data-blog-empty
          hidden
          style="text-align: center; padding: 4rem 0; border-top: 1px dashed var(--color-garden-line-soft); border-bottom: 1px dashed var(--color-garden-line-soft); margin-top: 2rem; color: var(--color-garden-ink-soft); font-style: italic;"
        >
          沒有符合條件的文章
        </div>
      </section>

      <!-- K8s 系列：折疊 -->
      {
        k8sLessons.length > 0 && (
          <details class="garden-collapse" id="k8s">
            <summary>
              Kubernetes 教學系列 · {k8sLessons.length.toString().padStart(2, '0')} 課
            </summary>
            <div style="padding-top: 1.5rem;">
              <p style="font-family: var(--font-garden-serif); color: var(--color-garden-ink-soft); margin-bottom: 1.5rem; line-height: 1.65;">
                完全沒碰過 K8s 的新手向。每一課對應一個搜尋意圖，從「為什麼需要 K8s」一路講到上線、Probe、HPA。
              </p>
              {k8sByGroup.map((g) => (
                <div style="margin-bottom: 2rem;">
                  <div class="garden-eyebrow" style="margin-bottom: 0.75rem; color: var(--color-garden-crimson);">
                    {g.meta.label} · {g.lessons.length.toString().padStart(2, '0')} lessons
                  </div>
                  <ol style="list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--color-garden-line);">
                    {g.lessons.map((lesson, idx) => (
                      <li style="border-bottom: 1px solid var(--color-garden-line);">
                        <a
                          href={withBase(`/blog/k8s/${lesson.slug}`)}
                          style="display: flex; align-items: baseline; gap: 1rem; padding: 0.875rem 0; color: inherit; text-decoration: none;"
                        >
                          <span style="font-family: var(--font-garden-sans); font-size: 0.75rem; color: var(--color-garden-ink-soft); width: 1.5rem; flex-shrink: 0;">
                            {(idx + 1).toString().padStart(2, '0')}
                          </span>
                          <span style="flex: 1; font-family: var(--font-garden-serif); font-size: 1.0625rem;">
                            {lesson.title}
                          </span>
                          <span style="font-family: var(--font-garden-sans); font-size: 0.75rem; color: var(--color-garden-ink-soft); flex-shrink: 0;">
                            {lesson.readingTime} min
                          </span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              ))}
              <p style="font-family: var(--font-garden-serif); font-style: italic; color: var(--color-garden-ink-soft); font-size: 0.9375rem; margin-top: 2rem;">
                更多主題（HPA、Probe、Helm、RBAC、StatefulSet…）持續補上中。
              </p>
            </div>
          </details>
        )
      }

      <!-- Motto -->
      <section style="margin-top: 5rem; padding-top: 3rem; border-top: 1px solid var(--color-garden-line);">
        <div class="garden-eyebrow" style="margin-bottom: 1rem;">Motto</div>
        <blockquote style="font-family: var(--font-garden-serif); font-style: italic; font-size: 1.375rem; line-height: 1.5; color: var(--color-garden-ink); margin: 0 0 1.5rem; max-width: 36ch;">
          我輩修行之人，以
          <span style="color: var(--color-garden-crimson); font-style: normal;">聖</span>
          的標準要求自己，以
          <span style="color: var(--color-garden-crimson); font-style: normal;">凡</span>
          的眼光理解別人。
        </blockquote>
        <p style="font-family: var(--font-garden-sans); font-weight: 700; letter-spacing: 0.08em; color: var(--color-garden-ink); font-size: 0.9375rem;">
          不怕死，只怕不過癮。
        </p>
      </section>
    </div>
  </main>

  <FooterNeub />
</RootLayout>
