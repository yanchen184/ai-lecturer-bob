---
/**
 * /blog — 部落格列表（Neub 風格，跟首頁一致）
 *
 * 結構（從上到下）:
 *   1. Header
 *   2. Featured Hero（最多人讀）
 *   3. Filters
 *   4. All posts（magazine grid，2-3 欄）
 *   5. 閱讀系列（Hermes、Claude Code 初階班、K8s...）
 *   6. Motto
 *
 * SSR 出完整列表（SEO），搜尋 / 篩選由 BlogFilters island 控 DOM。
 */
import RootLayout from '../../layouts/RootLayout.astro';
import NavbarNeub from '../../components/NavbarNeub.astro';
import FooterNeub from '../../components/FooterNeub.astro';
import BlogFilters from '../../components/BlogFilters.tsx';
import BlogCardListItem from '../../components/BlogCardListItem.astro';
import BlogFeaturedHero from '../../components/BlogFeaturedHero.astro';
import BlogSeriesBlock from '../../components/BlogSeriesBlock.astro';
import {
  getAllPublishedPosts,
  getTopViewedSlugs,
  getViewsMap,
} from '../../lib/firestore';
import { buildSeriesGroups } from '../../lib/series';
import { getAllK8sLessons, groupMeta, type K8sLesson } from '../../lib/k8s';
import { withBase } from '../../lib/url';

const posts = await getAllPublishedPosts();
const viewsMap = await getViewsMap();

const categories = [...new Set(posts.map((p) => p.category))];
const tags = [...new Set(posts.flatMap((p) => p.tags))];

const topSlugs = await getTopViewedSlugs();
const heroPost =
  topSlugs.map((slug) => posts.find((p) => p.slug === slug)).find(Boolean) ??
  posts.find((p) => p.featured);

const listPosts = heroPost ? posts.filter((p) => p.slug !== heroPost.slug) : posts;

const seriesGroups = buildSeriesGroups(posts);

const k8sLessons = getAllK8sLessons();
const k8sByGroup = (Object.keys(groupMeta) as Array<K8sLesson['group']>)
  .sort((a, b) => groupMeta[a].order - groupMeta[b].order)
  .map((g) => ({
    key: g,
    meta: groupMeta[g],
    lessons: k8sLessons.filter((l) => l.group === g),
  }))
  .filter((g) => g.lessons.length > 0);

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (p: string) => `${siteOrigin}${withBase(p)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: '陳彥彤 YC · AI 顧問 — 部落格',
  description: 'AI 工程師 + Java 後端的技術實戰筆記',
  url: absoluteUrl('/blog'),
  blogPost: posts.slice(0, 10).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.title,
    url: absoluteUrl(`/blog/${p.slug}`),
    datePublished: p.publishDate,
    author: { '@type': 'Person', name: p.author },
  })),
};
---

<RootLayout
  title="AI 工程師技術部落格 — LLM、RAG、Agent、Spring Boot 實戰筆記"
  description="AI 工程師 + Java 後端的技術筆記。LLM、RAG、Agent 導入心得；Spring Boot、React、MySQL、Redis、雲端踩坑紀錄；企業內訓現場觀察。陳彥彤 YC 撰寫。"
  canonical="/blog"
  jsonLd={jsonLd}
>
  <NavbarNeub />

  <main>
    <div class="max-w-7xl mx-auto px-6 md:px-10 py-12 md:py-16">
      <!-- Header -->
      <header class="mb-10">
        <div class="text-xs uppercase tracking-widest font-mono opacity-60 mb-3">
          The Bob Post · 後端踩坑筆記 + 教學現場
        </div>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-none">
          <span class="bg-[var(--color-neub-yellow)] px-2 box-decoration-clone">部落格</span>
        </h1>
        <p class="mt-6 text-base md:text-lg leading-relaxed opacity-80 max-w-3xl">
          AI 工程師 + Java 後端的技術筆記。LLM / RAG / Agent 導入、Spring Boot、雲端踩坑、教學現場觀察。共
          <strong class="bg-[var(--color-neub-yellow)] px-1">{posts.length}</strong> 篇。
        </p>
      </header>

      <!-- Featured hero -->
      {heroPost && <BlogFeaturedHero post={heroPost} views={viewsMap.get(heroPost.slug)} />}

      <!-- Filters (隨頁面捲動,不 sticky — 避免卡住畫面遮內容) -->
      <div class="mb-10">
        <BlogFilters
          client:load
          categories={categories}
          tags={tags}
          totalPosts={posts.length}
        />
      </div>

      <!-- All posts (magazine grid) -->
      <section class="mb-16">
        <div class="flex items-baseline justify-between mb-5">
          <div class="text-xs uppercase tracking-widest font-mono font-black">
            全部文章
          </div>
          <div class="text-[11px] uppercase tracking-widest font-mono opacity-60">
            {listPosts.length} posts
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {listPosts.map((post) => (
            <BlogCardListItem post={post} views={viewsMap.get(post.slug)} />
          ))}
        </div>

        <div
          data-blog-empty
          hidden
          class="border-2 border-dashed border-black p-10 md:p-14 text-center mt-6"
        >
          <div class="text-5xl md:text-6xl font-black mb-3 opacity-30">?</div>
          <div class="font-mono uppercase tracking-widest text-sm mb-2 opacity-70">
            沒有符合條件的文章
          </div>
          <div class="text-xs opacity-60 mb-5">
            可能是關鍵字太特殊,或者這個分類還沒寫到
          </div>
          <button
            type="button"
            onclick="window.__resetBlogFilters?.()"
            class="inline-flex items-center gap-2 text-xs uppercase tracking-widest font-black font-mono bg-black text-[var(--color-neub-yellow)] border-2 border-black px-4 py-2 hover:bg-[var(--color-neub-yellow)] hover:text-black transition-colors"
          >
            ← 清除篩選看全部
          </button>
        </div>
      </section>

      <!-- 閱讀系列（含 K8s 教學） -->
      {(seriesGroups.length > 0 || k8sLessons.length > 0) && (
        <section class="mb-16" data-blog-section="series">
          <div class="flex items-baseline justify-between mb-5">
            <div>
              <div class="text-xs uppercase tracking-widest font-mono font-black">
                閱讀系列
              </div>
              <p class="text-xs md:text-sm opacity-60 mt-1">
                按照閱讀順序集中露出 — 從第一篇開始讀更順
              </p>
            </div>
            <div class="text-[11px] uppercase tracking-widest font-mono opacity-60">
              {seriesGroups.length + (k8sLessons.length > 0 ? 1 : 0)} series
            </div>
          </div>

          {seriesGroups.map((g, i) => (
            <BlogSeriesBlock group={g} defaultOpen={i === 0} />
          ))}

          {/* K8s 教學系列 — 結構不同(分組 lessons),沿用既有渲染但對齊新風格 */}
          {k8sLessons.length > 0 && (
            <details class="border-2 border-black bg-white mb-4 group/series" id="k8s">
              <summary class="cursor-pointer list-none p-4 md:p-5 flex items-center justify-between gap-4 hover:bg-[var(--color-neub-yellow)] transition-colors border-b-2 border-black">
                <div class="min-w-0">
                  <div class="text-[11px] uppercase tracking-widest font-mono opacity-60 mb-1 flex items-center gap-2">
                    <span>series</span>
                    <span class="opacity-40">·</span>
                    <span class="font-black">{k8sLessons.length.toString().padStart(2, '0')} 課</span>
                  </div>
                  <div class="text-lg md:text-xl font-black tracking-tight truncate">
                    Kubernetes 教學系列
                  </div>
                </div>
                <span
                  class="text-2xl font-black flex-shrink-0 transition-transform duration-200 group-open/series:rotate-45"
                  aria-hidden="true"
                >+</span>
              </summary>

              <div class="p-4 md:p-5">
                <p class="text-sm md:text-base leading-relaxed opacity-80 mb-5">
                  完全沒碰過 K8s 的新手向。每一課對應一個搜尋意圖，從「為什麼需要 K8s」一路講到上線、Probe、HPA。
                </p>

                {k8sByGroup.map((g) => (
                  <div class="mb-6 last:mb-0">
                    <div class="text-[11px] uppercase tracking-widest font-mono font-black mb-2 bg-[var(--color-neub-yellow)] inline-block px-2 py-0.5 border-2 border-black">
                      {g.meta.label} · {g.lessons.length.toString().padStart(2, '0')} lessons
                    </div>
                    <ol class="list-none p-0 m-0 border-2 border-black bg-white mt-2">
                      {g.lessons.map((lesson, idx) => (
                        <li class="border-b-2 border-black last:border-b-0">
                          <a
                            href={withBase(`/blog/k8s/${lesson.slug}`)}
                            class="flex items-baseline gap-3 p-3 hover:bg-[var(--color-neub-yellow)] transition-colors"
                          >
                            <span class="text-xs font-mono opacity-50 w-7 flex-shrink-0 font-black">
                              {(idx + 1).toString().padStart(2, '0')}
                            </span>
                            <span class="flex-1 min-w-0">
                              <span class="block font-black leading-snug truncate">
                                {lesson.title}
                              </span>
                              <span class="block text-[11px] font-mono opacity-60 mt-0.5">
                                {lesson.readingTime} min
                              </span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </div>
                ))}

                <p class="text-xs italic opacity-60 mt-4">
                  更多主題（HPA、Probe、Helm、RBAC、StatefulSet…）持續補上中。
                </p>
              </div>
            </details>
          )}
        </section>
      )}

      <!-- Motto -->
      <section class="mt-16 pt-10 border-t-[3px] border-black">
        <div class="text-xs uppercase tracking-widest font-mono opacity-60 mb-3">
          Motto
        </div>
        <blockquote class="text-xl md:text-2xl font-black leading-snug max-w-2xl mb-4">
          我輩修行之人，以
          <span class="bg-[var(--color-neub-yellow)] px-1">聖</span>
          的標準要求自己，以
          <span class="bg-[var(--color-neub-yellow)] px-1">凡</span>
          的眼光理解別人。
        </blockquote>
        <p class="font-mono font-black uppercase tracking-widest text-sm">
          不怕死，只怕不過癮。
        </p>
      </section>
    </div>
  </main>

  <FooterNeub />
</RootLayout>
