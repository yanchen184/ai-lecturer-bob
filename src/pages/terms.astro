---
/** /terms — ycyt（YouTube Data API 自用工具）服務條款。 */
import RootLayout from '../layouts/RootLayout.astro';
import NavbarNeub from '../components/NavbarNeub.astro';
import FooterNeub from '../components/FooterNeub.astro';
import { CONTACT_EMAIL } from '../data/services';
import { withBase } from '../lib/url';

const EFFECTIVE_DATE = '2026-11-26';
const h2 = 'text-2xl font-black tracking-tight mt-10 mb-3';
const p = 'leading-relaxed mb-3';
const a = 'underline decoration-2 underline-offset-2 hover:bg-[var(--color-neub-yellow)] break-all';
---

<RootLayout
  title="服務條款 Terms of Service | AI 講師陳彥彤YC"
  description="ycyt（YouTube Data API 自用工具）的服務條款。"
  canonical="/terms"
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <article class="max-w-3xl mx-auto px-6 md:px-10 py-14 md:py-20">
      <h1 class="text-4xl md:text-5xl font-black tracking-tighter">服務條款</h1>
      <p class="mt-2 font-mono text-sm opacity-70">Terms of Service · 生效日期 Effective date：{EFFECTIVE_DATE}</p>

      <section lang="zh-Hant">
        <h2 class={h2}>服務說明</h2>
        <p class={p}>
          ycyt 是 Google Cloud 專案 yanchen0402 中的 OAuth 應用程式，為本網站擁有者陳彥彤（Bob Chen）自用的工具，
          用 YouTube Data API 管理自己的 YouTube 頻道。
        </p>

        <h2 class={h2}>使用者義務</h2>
        <p class={p}>
          使用 ycyt 須遵守 <a class={a} href="https://www.youtube.com/t/terms" target="_blank" rel="noopener">YouTube 服務條款</a>。
          資料處理方式見本站<a class={a} href={withBase('/privacy')}>隱私權政策</a>。
        </p>

        <h2 class={h2}>無擔保</h2>
        <p class={p}>ycyt 依「現狀」提供，不提供任何明示或默示的擔保。</p>

        <h2 class={h2}>聯絡方式</h2>
        <p class={p}>請寄信至 <a class={a} href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>。</p>
      </section>

      <hr class="my-14 border-t-[3px] border-black" />

      <section lang="en">
        <h2 class="text-3xl font-black tracking-tight mb-3">Terms of Service (English)</h2>
        <p class="font-mono text-sm opacity-70 mb-6">Effective date: {EFFECTIVE_DATE}</p>

        <h2 class={h2}>Service</h2>
        <p class={p}>
          ycyt is an OAuth application in Google Cloud project yanchen0402. It is a personal tool used by the owner of this
          website, Bob Chen, to manage the owner's own YouTube channel through the YouTube Data API.
        </p>

        <h2 class={h2}>User obligations</h2>
        <p class={p}>
          Users of ycyt must comply with the
          <a class={a} href="https://www.youtube.com/t/terms" target="_blank" rel="noopener">YouTube Terms of Service</a>.
          See the <a class={a} href={withBase('/privacy')}>Privacy Policy</a> for how data is handled.
        </p>

        <h2 class={h2}>No warranty</h2>
        <p class={p}>ycyt is provided "as is", without warranty of any kind, express or implied.</p>

        <h2 class={h2}>Contact</h2>
        <p class={p}>Email <a class={a} href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
      </section>
    </article>
  </main>

  <FooterNeub />
</RootLayout>
