---
/**
 * 404 Not Found — 靜態 Neub 風格。
 * Astro build 時輸出為 dist/404.html，GitHub Pages 會自動用於所有不存在的路徑。
 */
import RootLayout from '../layouts/RootLayout.astro';
import NavbarNeub from '../components/NavbarNeub.astro';
import FooterNeub from '../components/FooterNeub.astro';
import { withBase } from '../lib/url';
---

<RootLayout
  title="404 — 找不到頁面 | AI 講師陳彥彤YC"
  description="你要找的頁面不存在，可能被搬走、重新命名，或從來沒存在過。"
  canonical="/404"
  noindex={true}
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a] min-h-[70vh] flex items-center">
    <div class="max-w-5xl mx-auto w-full px-6 md:px-10 py-20">
      <div
        class="relative bg-white border-2 border-black p-10 md:p-16"
        style="box-shadow: 10px 10px 0 #0a0a0a;"
      >
        <div
          class="absolute -top-4 -right-4 px-3 py-1 text-xs uppercase tracking-widest border-2 border-black font-black bg-[var(--color-neub-yellow)] font-mono"
        >
          status: 404
        </div>

        <div class="relative inline-block">
          <h1
            class="text-[6rem] md:text-[9rem] font-black leading-none tracking-tighter mb-2"
          >
            4<span style="color: #ff6ec7;">0</span>4
          </h1>
          <span
            class="absolute -top-2 -right-8 text-xs font-mono px-2 py-0.5 rotate-12 inline-block bg-black text-[var(--color-neub-yellow)] border-2 border-black"
          >
            oops
          </span>
        </div>

        <p class="text-2xl md:text-3xl font-black tracking-tight mt-8 mb-3">
          找不到頁面
        </p>
        <p class="text-base opacity-70 mb-2 leading-relaxed max-w-2xl">
          你要找的頁面可能被搬走、重新命名，或從來沒存在過。
          也許可以先逛逛部落格，或回首頁看看最新內容。
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={withBase('/')}
            class="px-5 py-3 text-sm uppercase tracking-widest font-black bg-[var(--color-neub-yellow)] border-2 border-black font-mono hover:bg-black hover:text-white transition-colors"
            style="box-shadow: 4px 4px 0 #0a0a0a;"
          >
            → 回首頁
          </a>
          <a
            href={withBase('/blog')}
            class="px-5 py-3 text-sm uppercase tracking-widest font-black bg-white border-2 border-black font-mono hover:bg-[var(--color-neub-yellow)] transition-colors"
            style="box-shadow: 4px 4px 0 #0a0a0a;"
          >
            → 逛部落格
          </a>
          <a
            href="mailto:bobchen184@gmail.com"
            class="px-5 py-3 text-sm uppercase tracking-widest font-black bg-white border-2 border-black font-mono hover:bg-[var(--color-neub-yellow)] transition-colors"
            style="box-shadow: 4px 4px 0 #0a0a0a;"
          >
            → 聯繫我
          </a>
        </div>
      </div>

      <!-- 裝飾 -->
      <div class="hidden md:block relative mt-8 h-16">
        <div
          class="absolute left-10 top-0 w-16 h-16 rotate-12 bg-[#ff6ec7] border-2 border-black"
          style="box-shadow: 4px 4px 0 #0a0a0a;"
          aria-hidden="true"
        ></div>
        <div
          class="absolute right-20 -top-6 w-12 h-12 -rotate-6 bg-[#00ffd1] border-2 border-black"
          style="box-shadow: 4px 4px 0 #0a0a0a;"
          aria-hidden="true"
        ></div>
      </div>
    </div>
  </main>

  <FooterNeub />
</RootLayout>
