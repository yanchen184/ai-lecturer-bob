---
/**
 * /admin — 後台統計儀表板（noindex）。
 *
 * 完全在瀏覽器端跑：透過 firebase-client.ts 的 subscribe 實時從 Firestore 讀
 * 訪客 / 文章瀏覽 / 外連點擊等資料。資料源與 /ig-create skill 寫入一致。
 */
import RootLayout from '../layouts/RootLayout.astro';
import NavbarNeub from '../components/NavbarNeub.astro';
import FooterNeub from '../components/FooterNeub.astro';
import AdminDashboard from '../components/AdminDashboard.tsx';
---

<RootLayout
  title="Admin — AI 講師陳彥彤YC"
  description="Admin — 本站統計儀表板。"
  canonical="/admin"
  noindex={true}
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <section class="px-6 md:px-10 py-10 border-b-2 border-black bg-white">
      <div class="max-w-6xl mx-auto">
        <div
          class="inline-block px-2 py-1 mb-4 text-xs uppercase tracking-widest border-2 border-black font-black bg-[var(--color-neub-yellow)] font-mono"
        >
          private · noindex
        </div>
        <h1 class="text-3xl md:text-4xl font-black tracking-tight mb-2">
          Admin Dashboard
        </h1>
        <p class="text-sm md:text-base opacity-70 leading-relaxed">
          訪客 · 文章瀏覽 · 外連點擊 · 留言板即時從 Firestore 訂閱；SEO 讀每日 GSC 靜態快照。
        </p>
      </div>
    </section>

    <section class="px-6 md:px-10 py-8 bg-[#FAFAFA]">
      <div class="max-w-6xl mx-auto">
        <AdminDashboard client:only="react" />
      </div>
    </section>
  </main>

  <FooterNeub />
</RootLayout>
