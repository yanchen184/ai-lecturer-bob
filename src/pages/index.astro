    >
      <!-- 背景格線（淺色細線） -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-[0.04]"
        style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 44px 44px;"
      ></div>

      <div class="relative max-w-7xl mx-auto grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:items-start">
        <!-- 左：標題欄 -->
        <div>
          <div class="text-[11px] md:text-[12px] font-mono tracking-[0.25em] text-black/50 mb-4">
            // 企業內訓 <span class="mx-1 text-black/30">·</span> 實戰落地
          </div>
          <h1 class="text-3xl md:text-4xl lg:text-[2.9rem] xl:text-[3.1rem] font-black leading-[1.14] tracking-tight">
            <span class="block">讓團隊真正用好 AI，</span>
            <span class="block mt-1.5">創造可衡量的業務價值</span>
          </h1>

          <p class="mt-7 text-[15px] md:text-base max-w-lg leading-relaxed text-black/70">
            結合後端工程、系統架構與生成式 AI 實戰經驗，設計貼近企業場景的內訓課程與工作坊，從概念到落地，帶團隊建立可持續的 AI 生產力。
          </p>

          <!-- mobile 限定人像卡（對齊目標 mobile hero：大標下緊接人像） -->
