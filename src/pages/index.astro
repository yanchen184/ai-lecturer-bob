---
/**
 * / — 形象首頁（Hero → 關於 → 技能棧 → 課程 → 最新文章 → 聯繫）
 * 保留 Neub 風格底但移除 /// // 裝飾前綴。
 */
import RootLayout from '../layouts/RootLayout.astro';
import NavbarNeub from '../components/NavbarNeub.astro';
import FooterNeub from '../components/FooterNeub.astro';
import Testimonials from '../sections/Testimonials.astro';
import MessageBoard from '../components/MessageBoard.tsx';
import { getAllPublishedPosts } from '../lib/firestore';
import { withBase } from '../lib/url';

const posts = await getAllPublishedPosts();
const latest = posts.slice(0, 3);
const formatDate = (d: string) => d.replaceAll('-', '/');

const stats = [
  { number: '8 年', label: 'Java 後端' },
  { number: '2 年', label: 'AI 工程師' },
  { number: '10-50 場', label: '企業內訓' },
  { number: 'AZ-900', label: 'Azure 認證' },
];

const skills = [
  { group: 'AI', label: 'ai', color: '#ffaa00', items: ['LLM 應用', 'RAG', 'Agent', '語音辨識', 'Prompt 設計'] },
  { group: '後端', label: 'backend', color: 'var(--color-neub-yellow)', items: ['Spring Boot 4', 'Java 21', 'Maven', 'JPA / Hibernate'] },
  { group: '資料', label: 'data', color: '#00ffd1', items: ['MySQL', 'MSSQL', 'Redis', 'RabbitMQ'] },
  { group: '前端', label: 'frontend', color: '#ff6ec7', items: ['React 19', 'TypeScript', 'Vite', 'Tailwind CSS'] },
  { group: '雲端', label: 'cloud', color: '#7cc0ff', items: ['Azure (AZ-900)', 'Docker', 'GitHub Actions', 'Firebase'] },
];

const courses = [
  {
    title: '企業 AI 內訓 · 從 LLM 到落地',
    desc: '給工程團隊的 AI 培訓。從 LLM 基礎、RAG、Agent，到怎麼把 AI 整進現有系統。內容會根據貴司技術棧客製，不是統一講義。',
    tags: ['AI 內訓', 'RAG', 'LLM 應用'],
  },
  {
    title: 'AI 顧問 · 架構與導入',
    desc: '給正在想「AI 怎麼導入」的團隊。先聊現況、聊資料、聊預算，再給一份能落地的計畫。也接系統架構與後端效能的長期顧問。',
    tags: ['AI 導入', '架構顧問', '技術選型'],
  },
  {
    title: '前後端與雲端內訓',
    desc: 'Java + Spring Boot 後端、React + TypeScript 前端、Azure 雲端基礎。內容從電商核心系統真實場景延伸，不走 Hello World。',
    tags: ['Spring Boot', 'React', 'Azure'],
  },
];
---

<RootLayout
  title="陳彥彤 YC — AI 顧問 · AI 企業培訓 · Java 後端 8 年"
  description="陳彥彤 Bob Chen — AI 工程師 · AI 顧問。Java 後端 8 年、AI 工程師 2 年。提供 AI 內訓、AI 導入顧問，以及前後端、雲端的企業培訓。"
  canonical="/"
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <!-- Hero -->
    <section class="px-6 md:px-10 py-20 md:py-28 border-b-[3px] border-black">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-4 font-mono">
          ai engineer · backend · consultant
        </div>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black leading-[1.1] md:leading-[1.05] tracking-tight">
          <span class="block">你好，我是</span>
          <span class="inline-block mt-2 bg-[var(--color-neub-yellow)] px-2 md:px-3 box-decoration-clone">
            陳彥彤 YC
          </span>
        </h1>

        <!-- 座右銘印章 -->
        <div class="mt-6 inline-flex items-center gap-2 text-xs md:text-sm font-mono">
          <span class="uppercase tracking-widest opacity-60">motto</span>
          <span class="inline-block bg-black text-white px-3 py-1 tracking-wider">
            不怕死，只怕不過癮。
          </span>
        </div>

        <p class="mt-6 text-lg md:text-xl max-w-3xl leading-relaxed opacity-80">
          Java 後端 8 年、AI 工程師 2 年。<br />
          做 AI 項目，也做 AI / 前後端 / 雲端的企業培訓與顧問。
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="#courses"
            class="px-6 py-3 bg-black text-white text-sm uppercase tracking-widest hover:bg-[var(--color-neub-yellow)] hover:text-black transition-colors font-mono"
          >
            預約課程諮詢 →
          </a>
          <a
            href={withBase('/blog')}
            class="inline-flex items-center gap-1 px-2 py-3 text-sm uppercase tracking-widest hover:text-black hover:bg-[var(--color-neub-yellow)] transition-colors font-mono underline decoration-black/20 decoration-2 underline-offset-4 hover:decoration-transparent"
          >
            瀏覽部落格 →
          </a>
        </div>

        <!-- Stats -->
        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4">
          {
            stats.map((s, i) => (
              <div
                class:list={[
                  'border-2 border-black px-4 py-5 md:p-6 transition-transform hover:-translate-y-0.5',
                  i === 0 ? 'bg-[var(--color-neub-yellow)]' : 'bg-white',
                ]}
                style="box-shadow: 4px 4px 0 #0a0a0a;"
              >
                <div class="text-2xl md:text-4xl font-black tracking-tight leading-none">
                  {s.number}
                </div>
                <div class="text-xs md:text-sm opacity-70 mt-2 font-mono uppercase tracking-wider">
                  {s.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Signature Work — 讓讀者記住「這個人實際做過的事」 -->
    <section class="relative overflow-hidden border-b-[3px] border-black bg-black text-white">
      <!-- 背景網格（印刷感） -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-[0.08]"
        style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;"
      ></div>

      <div class="relative max-w-7xl mx-auto px-6 md:px-10 py-20">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
          <div>
            <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
              [ what i've actually shipped ]
            </div>
            <h2 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1]">
              不是講師的履歷，<br />是<span class="bg-[var(--color-neub-yellow)] text-black px-2">工程師的成績單</span>。
            </h2>
          </div>
          <p class="text-sm md:text-base leading-relaxed max-w-md opacity-70 font-mono">
            在開始教書之前，我先是一個在產線上解 bug 的後端工程師。這些是我實際 ship 過的東西。
          </p>
        </div>

        <div class="grid gap-0 md:grid-cols-3 border-y-2 border-white/30">
          <div class="p-6 md:p-8 border-b-2 md:border-b-0 md:border-r-2 border-white/30">
            <div class="text-[10px] uppercase tracking-widest opacity-60 font-mono mb-3">
              production system
            </div>
            <div class="text-2xl md:text-3xl font-black leading-tight mb-2">
              WMS / MOX / MIX
            </div>
            <p class="text-sm opacity-70 leading-relaxed">
              電商核心的智能倉儲、訂單、貨品三套系統。從 0 開始參與架構設計、跨團隊整合、線上事故處理。
            </p>
          </div>

          <div class="p-6 md:p-8 border-b-2 md:border-b-0 md:border-r-2 border-white/30">
            <div class="text-[10px] uppercase tracking-widest opacity-60 font-mono mb-3">
              stack i actually ship with
            </div>
            <div class="text-2xl md:text-3xl font-black leading-tight mb-2">
              Spring Boot 4
            </div>
            <p class="text-sm opacity-70 leading-relaxed">
              Java 21 · JPA · Redis · RabbitMQ · MySQL。不是看書學的，是跟著 Spring Boot 從 2 到 4 一起踩出來的。
            </p>
          </div>

          <div class="p-6 md:p-8">
            <div class="text-[10px] uppercase tracking-widest opacity-60 font-mono mb-3">
              from dev to teacher
            </div>
            <div class="text-2xl md:text-3xl font-black leading-tight mb-2">
              AI / 前後端 / 雲端內訓
            </div>
            <p class="text-sm opacity-70 leading-relaxed">
              把產線上踩過的坑變成能帶人少走彎路的教材。10-50 場企業內訓累積出來的，不是滑面投影片，是工程師看得懂的內容。
            </p>
          </div>
        </div>

        <!-- 一句差異化 tagline -->
        <div class="mt-10 flex flex-wrap items-center gap-3 text-xs md:text-sm font-mono">
          <span class="inline-block border border-white/40 px-3 py-1 uppercase tracking-wider opacity-80">
            others
          </span>
          <span class="opacity-50">教你 prompt 工程</span>
          <span class="opacity-40">/</span>
          <span class="inline-block bg-[var(--color-neub-yellow)] text-black px-3 py-1 uppercase tracking-wider font-bold">
            me
          </span>
          <span class="opacity-90">帶你把 AI 整進公司系統</span>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-white">
      <div class="max-w-7xl mx-auto grid gap-12 lg:grid-cols-[1fr_2fr] items-start">
        <div>
          <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
            about me
          </div>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight leading-tight">
            關於我
          </h2>
          <div class="mt-6 inline-block bg-[var(--color-neub-yellow)] px-3 py-1 text-sm font-bold">
            陳彥彤 · Bob Chen
          </div>
        </div>

        <div class="space-y-5 text-base md:text-lg leading-relaxed">
          <p>
            我是<strong>陳彥彤</strong>，<strong>Java 後端工程師</strong>做了 8 年，近 2 年轉做<strong>AI 工程師</strong>，現在同時帶 <strong>AI 導入顧問</strong>與<strong>企業內訓</strong>。
          </p>
          <p>
            後端那邊是電商核心系統的長期經歷：智能倉儲系統（WMS）、訂單管理系統（MOX）、貨品管理系統（MIX），從架構設計、跨團隊整合、線上事故處理一路走過來。
          </p>
          <p>
            AI 那邊是把 LLM、RAG、Agent 真的接到公司既有系統裡的工程實踐——不是 demo prompt，是會被 PM 追進度、會被資安檢查、要長期維運的東西。
            這些經驗整理成系統化教材，帶 AI / 前後端 / 雲端三條線的企業內訓，也接 AI 導入的顧問案。
          </p>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-4">
            {
              [
                { title: 'AI 工程', desc: 'LLM · RAG · Agent' },
                { title: '後端專精', desc: 'Spring Boot · Java 8 年' },
                { title: '企業內訓', desc: '10-50 場累積' },
                { title: 'AI 顧問', desc: 'AI 導入專案' },
              ].map((i) => (
                <div class="border-2 border-black p-3">
                  <div class="font-black text-sm">{i.title}</div>
                  <div class="text-xs opacity-70 mt-1">{i.desc}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="px-6 md:px-10 py-20 border-b-[3px] border-black">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
          tech stack
        </div>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-10">
          技術專長
        </h2>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {
            skills.map((s) => (
              <div
                class="border-2 border-black bg-white overflow-hidden"
                style="box-shadow: 4px 4px 0 #0a0a0a;"
              >
                <div
                  class="px-5 py-3 border-b-2 border-black flex items-center justify-between font-mono"
                  style={`background: ${s.color};`}
                >
                  <span class="text-lg font-black">{s.group}</span>
                  <span class="text-[10px] uppercase tracking-widest opacity-70">
                    {s.label}
                  </span>
                </div>
                <ul class="p-5 space-y-2 text-sm font-bold">
                  {s.items.map((it) => (
                    <li class="flex items-start gap-2">
                      <span class="text-black/40 select-none">▸</span>
                      <span>{it}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Courses -->
    <section id="courses" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
          services
        </div>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-10">
          課程與服務
        </h2>

        <div class="grid gap-6 md:grid-cols-3">
          {
            courses.map((c) => (
              <div class="border-2 border-black p-6 hover:bg-[var(--color-neub-yellow)] transition-colors">
                <h3 class="text-lg font-black leading-tight mb-3">{c.title}</h3>
                <p class="text-sm leading-relaxed opacity-80 mb-4">{c.desc}</p>
                <div class="flex flex-wrap gap-1.5">
                  {c.tags.map((t) => (
                    <span class="text-xs border border-black px-1.5 py-0.5 font-mono">
                      #{t}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-10 text-center">
          <a
            href="#contact"
            class="inline-block px-6 py-3 bg-black text-white text-sm uppercase tracking-widest hover:bg-[var(--color-neub-yellow)] hover:text-black transition-colors font-mono"
          >
            立即聯繫 →
          </a>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <Testimonials />

    <!-- Latest Posts -->
    {
      latest.length > 0 && (
        <section class="px-6 md:px-10 py-20 border-b-[3px] border-black">
          <div class="max-w-7xl mx-auto">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 mb-10">
              <div>
                <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
                  latest posts
                </div>
                <h2 class="text-3xl md:text-4xl font-black tracking-tight">
                  最新文章
                </h2>
              </div>
              <a
                href={withBase('/blog')}
                class="self-start sm:self-auto text-xs uppercase tracking-widest underline font-mono hover:bg-[var(--color-neub-yellow)] px-1"
              >
                all posts →
              </a>
            </div>

            <div
              class:list={[
                'grid gap-0 border-t-2 border-black',
                latest.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2',
              ]}
            >
              {latest.map((p, i) => (
                <a
                  href={withBase(`/blog/${p.slug}`)}
                  class:list={[
                    'block p-6 border-b-2 border-black hover:bg-[var(--color-neub-yellow)] transition-colors',
                    i < latest.length - 1 ? 'md:border-r-2' : '',
                  ]}
                >
                  <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
                    [{p.category}] · {formatDate(p.publishDate)}
                  </div>
                  <h3 class="text-lg font-black leading-tight mb-2">{p.title}</h3>
                  <p class="text-sm opacity-70 line-clamp-2">{p.excerpt}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Message Board (Firebase island, lazy) -->
    <MessageBoard client:visible />

    <!-- Contact -->
    <section id="contact" class="px-6 md:px-10 py-20 bg-white">
      <div class="max-w-7xl mx-auto grid gap-10 md:grid-cols-2">
        <div>
          <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
            contact
          </div>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-6">
            開始合作
          </h2>
          <p class="text-base leading-relaxed opacity-80 mb-6">
            AI 內訓、AI 導入顧問、前後端與雲端培訓 —— 歡迎透過 Email 或 GitHub 聯繫。
            一對一諮詢與團隊培訓皆可客製化內容，先聊需求再報價。
          </p>

          <a
            href="mailto:bobchen184@gmail.com?subject=%5B%E5%90%88%E4%BD%9C%E9%9C%80%E6%B1%82%5D%20&body=%E5%97%A8%E5%BD%A5%E5%BD%A4%EF%BC%8C%0A%0A%E6%88%91%E6%83%B3%E8%81%8A%E8%81%8A%EF%BC%9A%0A%0A%E2%80%A2%20%E9%9C%80%E6%B1%82%E7%B1%BB%E5%9E%8B%EF%BC%88%E4%BC%81%E6%A5%AD%E5%85%A7%E8%A8%93%20%2F%20%E6%8A%80%E8%A1%93%E8%AB%AE%E8%A9%A2%20%2F%20%E7%B3%BB%E7%B5%B1%E9%A1%A7%E5%95%8F%EF%BC%89%EF%BC%9A%0A%E2%80%A2%20%E7%B0%A1%E8%BF%B0%E7%8B%80%E6%B3%81%EF%BC%9A%0A%E2%80%A2%20%E5%B8%8C%E6%9C%9B%E8%99%95%E7%90%86%E7%9A%84%E6%99%82%E7%A8%8B%EF%BC%9A%0A%0A%E8%AC%9D%E8%AC%9D%EF%BC%81"
            class="inline-flex items-center gap-3 px-6 py-4 bg-[var(--color-neub-yellow)] text-black text-sm uppercase tracking-widest font-black border-2 border-black font-mono hover:bg-black hover:text-[var(--color-neub-yellow)] transition-colors"
            style="box-shadow: 5px 5px 0 #0a0a0a;"
          >
            寄信談合作
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="space-y-4">
          <a
            href="mailto:bobchen184@gmail.com"
            class="flex items-center justify-between border-2 border-black p-5 hover:bg-[var(--color-neub-yellow)] transition-colors"
          >
            <div>
              <div class="text-xs uppercase tracking-widest opacity-60 font-mono mb-1">
                email
              </div>
              <div class="font-black">bobchen184@gmail.com</div>
            </div>
            <span class="text-xl">→</span>
          </a>

          <a
            href="https://github.com/yanchen184"
            target="_blank"
            rel="noopener"
            class="flex items-center justify-between border-2 border-black p-5 hover:bg-[var(--color-neub-yellow)] transition-colors"
          >
            <div>
              <div class="text-xs uppercase tracking-widest opacity-60 font-mono mb-1">
                github
              </div>
              <div class="font-black">yanchen184</div>
            </div>
            <span class="text-xl">→</span>
          </a>

          <a
            href={withBase('/blog')}
            class="flex items-center justify-between border-2 border-black p-5 hover:bg-[var(--color-neub-yellow)] transition-colors"
          >
            <div>
              <div class="text-xs uppercase tracking-widest opacity-60 font-mono mb-1">
                blog
              </div>
              <div class="font-black">技術文章與實戰筆記</div>
            </div>
            <span class="text-xl">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <FooterNeub />
</RootLayout>
