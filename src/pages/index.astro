---
/**
 * / — 形象首頁（Hero → 最近寫了什麼 → 關於 → Production → Skills → 找我 → FAQ → 留言）
 * 從「100% 接案漏斗」改成「寫作 + 解問題的工程師」人設站，接案濃縮成一塊。
 */
import RootLayout from '../layouts/RootLayout.astro';
import NavbarNeub from '../components/NavbarNeub.astro';
import FooterNeub from '../components/FooterNeub.astro';
import MessageBoard from '../components/MessageBoard.tsx';
import CharacterCompanion from '../components/CharacterCompanion.tsx';
import { getAllPublishedPosts } from '../lib/firestore';
import { withBase } from '../lib/url';

const posts = await getAllPublishedPosts();
const latest = posts.slice(0, 6);
const formatDate = (d: string) => d.replaceAll('-', '/');

const productionCases = [
  {
    domain: '醫療領域',
    title: '決策輔助系統的反饋學習機制',
    body: 'AI 模型隨臨床實際使用持續修正的閉環設計——讓模型不是上線就停在那，而是真的越用越準。',
    color: '#ff6ec7',
  },
  {
    domain: '企業語音辨識',
    title: '用聯發科 Breeze-ASR-25 落地',
    body: '協助企業導入繁體中文語音辨識（基於聯發科開源 ASR 模型），含部署、領域術語調教、品質監控。本土模型也能用得上。',
    color: '#ffaa00',
  },
  {
    domain: '企業內部',
    title: '會議記錄 RAG 檢索',
    body: '跨部門會議檔的向量檢索與語意問答，含 ACL 權限切割——不同角色看到不同會議，不靠 prompt 攔截，靠 retrieval 層先過濾。',
    color: '#7cc0ff',
  },
];

const faqs: { q: string; a: string }[] = [
  {
    q: '收費怎麼算？網站上為什麼看不到報價？',
    a: '我選擇「先聊需求再報價」，不放固定價格表。原因很直接：我想用「你們的需求對不對」來篩第一輪，不是用「價格能不能負擔」來篩——這兩件事篩出的客戶很不一樣。聊 30 分鐘了解你們團隊規模、對象、想做到什麼程度，價格我會直接告訴你，不繞圈子、不會有「先聊聊再追加」的情況。',
  },
  {
    q: '結訓後團隊還能繼續問問題嗎？',
    a: '可以。基本款：結訓後一個月內 email / Slack 群組 Q&A 不額外收費，避免學員回去卡住就放棄。延伸方案：雙週 review 顧問合作——做完一場內訓後最常被選的後續方案，把 AI 工具真的長到你們團隊的工作流裡。',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

const skills = [
  { group: 'AI', label: 'ai', color: '#ffaa00', items: ['LLM 應用', 'RAG', 'Agent', '語音辨識', 'Prompt 設計'] },
  { group: '後端', label: 'backend', color: 'var(--color-neub-yellow)', items: ['Spring Boot 4', 'Java 21', 'Maven', 'JPA / Hibernate'] },
  { group: '資料', label: 'data', color: '#00ffd1', items: ['MySQL', 'MSSQL', 'Redis', 'RabbitMQ'] },
  { group: '前端', label: 'frontend', color: '#ff6ec7', items: ['React 19', 'TypeScript', 'Vite', 'Tailwind CSS'] },
  { group: '雲端', label: 'cloud', color: '#7cc0ff', items: ['Azure (AZ-900)', 'Docker', 'GitHub Actions', 'Firebase'] },
];

const findMe = [
  {
    badge: '01',
    title: '企業內訓',
    desc: '半天 / 一天 / 兩天，工程師教工程師。給你大綱 + Q&A 預演 + 結訓 cheat sheet。',
    cta: '寄信聊內訓 →',
    subject: '[企業內訓] 想聊聊你的內訓方案',
    body: '嗨 YC，\n\n我是 ___（公司／團隊）___ 的 ___（職稱）___。\n\n• 對象（工程師 / PM / 主管）：\n• 大概人數：\n• 想學完做到的程度：\n• 預期時程：\n\n謝謝！',
    bg: 'bg-white',
  },
  {
    badge: '02',
    title: 'AI 導入顧問',
    desc: '場景盤點、技術選型、預算 / 風險清單、雙週 review。單次或季度合作都行。',
    cta: '寄信聊顧問 →',
    subject: '[AI 顧問] 想聊聊導入顧問',
    body: '嗨 YC，\n\n我是 ___（公司）___ 的 ___（職稱）___。\n\n• 目前情境：\n• 想解決的問題：\n• 已有的場景或痛點：\n• 預期時程：\n\n謝謝！',
    bg: 'bg-[var(--color-neub-yellow)]',
  },
  {
    badge: '03',
    title: '先看就好',
    desc: '不急著聊。先看技術筆記跟 GitHub，判斷我這個人合不合你們團隊的口味。',
    cta: '看部落格 / GitHub →',
    isLink: true,
    bg: 'bg-white',
  },
];
---

<RootLayout
  title="陳彥彤 YC — AI 工程師 / 寫作者 / 內訓講師"
  description="工程師不是寫 code 的人，是解決問題的人。Java 後端 8 年、AI 工程師 2 年。寫 Claude Code、AI Agent、RAG 落地踩坑筆記，順便接 AI 內訓與導入顧問。"
  canonical="/"
  jsonLd={faqJsonLd}
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <!-- Hero — manifesto 版 -->
    <section data-companion-section="hero" class="px-6 md:px-10 py-20 md:py-28 border-b-[3px] border-black">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-4 font-mono">
          yc's notebook · ai engineer · taiwan
        </div>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black leading-[1.1] md:leading-[1.05] tracking-tight">
          <span class="block">工程師不是寫 code 的人</span>
          <span class="inline-block mt-2 bg-[var(--color-neub-yellow)] px-2 md:px-3 box-decoration-clone">
            是解決問題的人
          </span>
        </h1>

        <p class="mt-8 text-lg md:text-xl max-w-3xl leading-relaxed opacity-80">
          我是<strong>陳彥彤（YC）</strong>。Java 後端 8 年、AI 工程師 2 年。<br class="hidden md:inline" />
          邊做 production AI 專案、邊寫筆記、邊教書。<br class="hidden md:inline" />
          這裡是我的踩坑紀錄、工具拆解，跟那些「文件不會寫」的細節。
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="#latest"
            class="px-6 py-3 bg-[var(--color-neub-yellow)] text-black text-sm uppercase tracking-widest border-2 border-black hover:bg-black hover:text-[var(--color-neub-yellow)] transition-colors font-mono font-black"
            style="box-shadow: 4px 4px 0 #0a0a0a;"
          >
            看技術筆記 →
          </a>
          <a
            href="#find-me"
            class="text-sm uppercase tracking-widest font-mono underline decoration-black/30 decoration-2 underline-offset-4 hover:bg-[var(--color-neub-yellow)] px-1 transition-colors"
          >
            想找我聊內訓 / 顧問
          </a>
        </div>

        <!-- Inline meta — 取代原本四欄統計卡 -->
        <div class="mt-14 pt-8 border-t-2 border-black/10">
          <div class="text-[11px] uppercase tracking-widest opacity-50 mb-2 font-mono">
            recently working with
          </div>
          <div class="text-sm md:text-base font-mono leading-relaxed">
            Claude Code · Routines · RAG with ACL · Breeze-ASR-25 · Spring Boot 4 · Java 21
          </div>
        </div>
      </div>
    </section>

    <!-- Latest Posts — 從第 12 區拉到 hero 正下方 -->
    {
      latest.length > 0 && (
        <section id="latest" data-companion-section="latest" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-[#fafaf6]">
          <div class="max-w-7xl mx-auto">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-10">
              <div>
                <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
                  notebook · 最近寫了什麼
                </div>
                <h2 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1]">
                  最近寫了什麼
                </h2>
                <p class="mt-3 text-sm md:text-base opacity-70 leading-relaxed max-w-2xl">
                  不是教學文，是 production 上踩到的東西。
                </p>
              </div>
              <a
                href={withBase('/blog')}
                class="self-start sm:self-auto text-xs uppercase tracking-widest underline font-mono hover:bg-[var(--color-neub-yellow)] px-1 font-black"
              >
                all posts →
              </a>
            </div>

            <div class="grid gap-0 border-t-2 border-black bg-white md:grid-cols-2 lg:grid-cols-3">
              {latest.map((p, i) => (
                <a
                  href={withBase(`/blog/${p.slug}`)}
                  class:list={[
                    'block p-5 border-b-2 border-black hover:bg-[var(--color-neub-yellow)] transition-colors',
                    'md:border-r-2',
                    (i + 1) % 2 === 0 ? 'md:[&:nth-child(2n)]:border-r-2 lg:[&:nth-child(2n)]:border-r-2' : '',
                    (i + 1) % 3 === 0 ? 'lg:[&:nth-child(3n)]:border-r-0' : '',
                  ]}
                >
                  <div class="text-[11px] uppercase tracking-widest opacity-60 mb-2 font-mono">
                    [{p.category}] · {formatDate(p.publishDate)}
                  </div>
                  <h3 class="text-base font-black leading-tight mb-2">{p.title}</h3>
                  <p class="text-sm opacity-70 line-clamp-2">{p.excerpt}</p>
                </a>
              ))}
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono opacity-70">
              <a href={withBase('/blog')} class="underline hover:bg-[var(--color-neub-yellow)] px-1 font-black">
                看全部文章 →
              </a>
              <a href={withBase('/rss.xml')} class="underline hover:bg-[var(--color-neub-yellow)] px-1">
                訂閱 RSS
              </a>
            </div>
          </div>
        </section>
      )
    }

    <!-- About — 加入兩句座右銘 -->
    <section id="about" data-companion-section="about" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-white">
      <div class="max-w-7xl mx-auto grid gap-12 lg:grid-cols-[1fr_2fr] items-start">
        <div>
          <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
            about me
          </div>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight leading-tight">
            關於我
          </h2>
          <div class="mt-6 inline-block bg-[var(--color-neub-yellow)] px-3 py-1 text-sm font-bold">
            陳彥彤 · Bob Chen · YC
          </div>
        </div>

        <div class="space-y-5 text-base md:text-lg leading-relaxed">
          <p>
            朋友叫我 YC。<strong>Java 後端 8 年</strong>起家，出身電商核心系統團隊（WMS / MOX / MIX），主責架構設計、跨團隊整合、線上事故處理。最近兩年把 LLM、RAG、Agent 真的接到既有公司系統裡。
          </p>
          <p>
            不是 demo、不是 PoC，是<strong>要過資安、要接 SSO、要評估成本、要監控品質、要長期維運</strong>的那種。
            這些落地經驗整理成教材，帶 AI / 前後端 / 雲端三條線的企業內訓，也接 AI 導入的顧問案。
          </p>
          <p>
            我寫東西的標準很簡單：<strong>今天的我會不會想看半年前的我寫的這篇</strong>。
            版本號、價錢、API 行為都當下查、發文前再 grep 一次，避免半年後變笑話。
          </p>
          <p class="text-base opacity-85 italic border-l-4 border-black pl-4 leading-relaxed">
            我相信「<strong>以聖的標準要求自己，以凡的眼光理解別人</strong>」。
            程式碼跟寫作我會自己挑剔到很煩，但教學現場我預設大家都跟當年的我一樣卡。<br />
            也相信「<strong>不怕死，只怕不過癮</strong>」——接案、寫文章、講課都選會讓自己進步的，不選安全牌。
          </p>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-4">
            {
              [
                { title: 'AI 工程', desc: 'LLM · RAG · Agent' },
                { title: '後端專精', desc: 'Spring Boot · Java' },
                { title: '寫作', desc: '工程踩坑筆記' },
                { title: '內訓 / 顧問', desc: 'AI 落地 + 內訓' },
              ].map((i) => (
                <div class="border-2 border-black p-3">
                  <div class="font-black text-sm">{i.title}</div>
                  <div class="text-xs opacity-70 mt-1">{i.desc}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Production AI 落地經驗 — 縮小版 -->
    <section id="production" data-companion-section="production" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
          <div>
            <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
              production ai · 正在跑的案子
            </div>
            <h2 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1]">
              正在跑的<br class="md:hidden" />
              <span class="bg-[var(--color-neub-yellow)] px-2">production AI</span>
            </h2>
          </div>
          <p class="text-sm md:text-base leading-relaxed max-w-md opacity-70">
            三個有上線的案子。NDA 抽象化過，但工程實踐是真的。
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {
            productionCases.map((p) => (
              <article
                class="border-2 border-black bg-white p-6 flex flex-col"
                style="box-shadow: 6px 6px 0 #0a0a0a;"
              >
                <div
                  class="inline-block self-start px-2 py-0.5 text-[11px] uppercase tracking-widest font-mono font-black mb-4 border-2 border-black"
                  style={`background: ${p.color};`}
                >
                  {p.domain}
                </div>
                <h3 class="text-xl md:text-2xl font-black leading-tight mb-4">
                  {p.title}
                </h3>
                <p class="text-sm leading-relaxed opacity-80 flex-1">
                  {p.body}
                </p>
              </article>
            ))
          }
        </div>

        <p class="mt-8 text-sm md:text-base font-mono opacity-70 max-w-3xl leading-relaxed">
          ▸ 這些案子的選型、踩坑、收尾，內訓現場可以拆給你工程團隊看。
        </p>
      </div>
    </section>

    <!-- Skills — 視覺保留但縮小 -->
    <section id="skills" data-companion-section="skills" class="px-6 md:px-10 py-14 border-b-[3px] border-black">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-2 font-mono">
          tech stack
        </div>
        <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-8">
          技術專長
        </h2>

        <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-5">
          {
            skills.map((s) => (
              <div
                class="border-2 border-black bg-white overflow-hidden"
                style="box-shadow: 3px 3px 0 #0a0a0a;"
              >
                <div
                  class="px-3 py-2 border-b-2 border-black flex items-center justify-between font-mono"
                  style={`background: ${s.color};`}
                >
                  <span class="text-sm font-black">{s.group}</span>
                  <span class="text-[9px] uppercase tracking-widest opacity-70">
                    {s.label}
                  </span>
                </div>
                <ul class="p-3 space-y-1 text-xs font-bold">
                  {s.items.map((it) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-black/40 select-none">▸</span>
                      <span>{it}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 找我 — 合併原本的 courses + contact 兩大區 -->
    <section id="find-me" data-companion-section="findme" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
          find me · 找我
        </div>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-3">
          找我
        </h2>
        <p class="text-sm md:text-base opacity-70 max-w-3xl leading-relaxed mb-10">
          寫作網站附帶接案。三個常見入口，挑一個寄信，<strong>主旨幫你寫好了</strong>。
        </p>

        <div class="grid gap-6 md:grid-cols-3">
          {
            findMe.map((c) => {
              const cardClass = `relative border-2 border-black ${c.bg} p-6 flex flex-col`;
              const cardStyle = 'box-shadow: 6px 6px 0 #0a0a0a;';
              return c.isLink ? (
                <div class={cardClass} style={cardStyle}>
                  <div class="absolute -top-3 -left-3 px-2 py-0.5 text-xs font-black uppercase border-2 border-black font-mono bg-[var(--color-neub-yellow)]">
                    {c.badge}
                  </div>
                  <h3 class="text-xl font-black leading-tight mb-3 mt-2">
                    {c.title}
                  </h3>
                  <p class="text-sm leading-relaxed opacity-85 mb-5 flex-1">
                    {c.desc}
                  </p>
                  <div class="space-y-2">
                    <a
                      href={withBase('/blog')}
                      class="flex items-center justify-between border-2 border-black px-3 py-2 text-sm hover:bg-[var(--color-neub-yellow)] transition-colors"
                    >
                      <span class="font-black">技術部落格</span>
                      <span>→</span>
                    </a>
                    <a
                      href="https://github.com/yanchen184"
                      target="_blank"
                      rel="noopener"
                      class="flex items-center justify-between border-2 border-black px-3 py-2 text-sm hover:bg-[var(--color-neub-yellow)] transition-colors"
                    >
                      <span class="font-black">GitHub @yanchen184</span>
                      <span>→</span>
                    </a>
                  </div>
                </div>
              ) : (
                <a
                  href={`mailto:bobchen184@gmail.com?subject=${encodeURIComponent(c.subject ?? '')}&body=${encodeURIComponent(c.body ?? '')}`}
                  class={`${cardClass} transition-transform hover:-translate-x-1 hover:-translate-y-1 group`}
                  style={cardStyle}
                >
                  <div class="absolute -top-3 -left-3 px-2 py-0.5 text-xs font-black uppercase border-2 border-black font-mono bg-[var(--color-neub-yellow)]">
                    {c.badge}
                  </div>
                  <h3 class="text-xl font-black leading-tight mb-3 mt-2">
                    {c.title}
                  </h3>
                  <p class="text-sm leading-relaxed opacity-85 mb-5 flex-1">
                    {c.desc}
                  </p>
                  <div class="border-t-2 border-black pt-3 mt-auto text-xs font-mono">
                    <span class="font-black uppercase tracking-widest">
                      {c.cta}
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>

        <!-- 直接資訊 -->
        <div class="mt-10 pt-6 border-t-2 border-black flex flex-wrap items-baseline gap-x-6 gap-y-2 text-sm font-mono opacity-80">
          <span class="font-black uppercase tracking-widest">direct contact</span>
          <a href="mailto:bobchen184@gmail.com" class="hover:bg-[var(--color-neub-yellow)] px-1">bobchen184@gmail.com</a>
          <span class="opacity-40">·</span>
          <a href="https://github.com/yanchen184" target="_blank" rel="noopener" class="hover:bg-[var(--color-neub-yellow)] px-1">github.com/yanchen184</a>
          <span class="opacity-40">·</span>
          <span>30 分鐘免費電話也行 — 不需要找講師我會直接告訴你</span>
        </div>
      </div>
    </section>

    <!-- FAQ — 縮成 2 題 -->
    <section id="faq" data-companion-section="faq" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-[#fafaf6]">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
          frequently asked
        </div>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-10">
          常見問題
        </h2>

        <div class="grid gap-4 md:grid-cols-2">
          {
            faqs.map((f, i) => (
              <details
                class="group border-2 border-black bg-white"
                style="box-shadow: 4px 4px 0 #0a0a0a;"
              >
                <summary class="cursor-pointer list-none p-5 flex items-start gap-4 hover:bg-[var(--color-neub-yellow)] transition-colors">
                  <span class="text-xs font-mono font-black opacity-50 mt-0.5 shrink-0">
                    Q{(i + 1).toString().padStart(2, '0')}
                  </span>
                  <span class="font-black text-base leading-snug flex-1">
                    {f.q}
                  </span>
                  <span class="font-mono opacity-50 transition-transform group-open:rotate-90 shrink-0">
                    ›
                  </span>
                </summary>
                <div class="px-5 pb-5 pl-12 text-sm leading-relaxed opacity-85 border-t-2 border-black/10">
                  <p class="pt-4">{f.a}</p>
                </div>
              </details>
            ))
          }
        </div>

        <p class="mt-8 text-sm font-mono opacity-70">
          ▸ 還有其他疑問？直接寄信問就好——
          <a href="mailto:bobchen184@gmail.com" class="underline font-black hover:bg-[var(--color-neub-yellow)] px-1">
            bobchen184@gmail.com
          </a>
        </p>
      </div>
    </section>

    <!-- Message Board (Firebase island, lazy) -->
    <div data-companion-section="message">
      <MessageBoard client:visible />
    </div>
  </main>

  <FooterNeub />

  <!-- Character video companion (floating bottom-right, scroll-aware) -->
  <CharacterCompanion client:idle />
</RootLayout>
