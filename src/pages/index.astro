            <img
              src={withBase('/images/character/half_01.png')}
              alt="陳彥彤 YC"
              class="absolute inset-0 w-full h-full object-cover object-top"
              loading="eager"
              decoding="async"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-black text-white px-3 py-2">
              <span class="block text-[12px] font-mono font-black tracking-widest">&gt; YC / Bob Chen</span>
              <span class="block text-[9px] font-mono uppercase tracking-widest text-white/55">AI LECTURER / SENIOR BACKEND ENGINEER</span>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="#contact"
              class="px-6 py-3 bg-[var(--color-neub-yellow)] text-black text-sm uppercase tracking-widest border-2 border-black font-mono font-black shadow-hard hover:-translate-y-0.5 transition-transform"
            >
              查看內訓方案 ↗
            </a>
            <a
              href="#about"
              class="px-6 py-3 text-sm uppercase tracking-widest font-mono font-black border-2 border-black bg-white shadow-hard hover:-translate-y-0.5 transition-transform"
            >
              關於我 ↗
            </a>
          </div>

          <!-- AI WORKFLOW 五步橫條 -->
          <div class="mt-11">
            <div class="text-[11px] font-mono uppercase tracking-[0.25em] text-black/50 mb-3">// AI WORKFLOW</div>
            <div class="flex flex-wrap items-stretch gap-2">
              {
                [
                  { c: 'var(--color-neub-yellow)', zh: '問題定義', en: 'Problem' },
                  { c: '#5b9bff', zh: '資料理解', en: 'Data' },
                  { c: '#3ec5c5', zh: '模型與工具', en: 'Model' },
                  { c: '#5b9bff', zh: '整合落地', en: 'Integration' },
                  { c: '#ff4fa3', zh: '持續優化', en: 'Optimize' },
                ].map((s, i, arr) => (
                  <>
                    <div class="flex items-center gap-2 border-2 border-black bg-white px-3 py-2">
                      <span class="w-3 h-3 border border-black inline-block shrink-0" style={`background:${s.c}`}></span>
                      <span class="leading-tight">
                        <span class="block text-[12px] font-black">{s.zh}</span>
                        <span class="block text-[9px] font-mono uppercase tracking-wider text-black/45">{s.en}</span>
                      </span>
                    </div>
