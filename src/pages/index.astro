---
/**
 * / — 形象首頁（Hero → 關於 → 技能棧 → 課程 → 最新文章 → 聯繫）
 * 保留 Neub 風格底但移除 /// // 裝飾前綴。
 */
import RootLayout from '../layouts/RootLayout.astro';
import NavbarNeub from '../components/NavbarNeub.astro';
import FooterNeub from '../components/FooterNeub.astro';
import Testimonials from '../sections/Testimonials.astro';
import MessageBoard from '../components/MessageBoard.tsx';
import { getAllPublishedPosts } from '../lib/firestore';
import { withBase } from '../lib/url';

const posts = await getAllPublishedPosts();
const latest = posts.slice(0, 3);
const formatDate = (d: string) => d.replaceAll('-', '/');

const stats = [
  { number: '8 年', label: 'Java 後端' },
  { number: '2 年', label: 'AI 工程師' },
  { number: '10-50 場', label: '企業內訓' },
  { number: 'AZ-900', label: 'Azure 認證' },
];

const skills = [
  { group: 'AI', label: 'ai', color: '#ffaa00', items: ['LLM 應用', 'RAG', 'Agent', '語音辨識', 'Prompt 設計'] },
  { group: '後端', label: 'backend', color: 'var(--color-neub-yellow)', items: ['Spring Boot 4', 'Java 21', 'Maven', 'JPA / Hibernate'] },
  { group: '資料', label: 'data', color: '#00ffd1', items: ['MySQL', 'MSSQL', 'Redis', 'RabbitMQ'] },
  { group: '前端', label: 'frontend', color: '#ff6ec7', items: ['React 19', 'TypeScript', 'Vite', 'Tailwind CSS'] },
  { group: '雲端', label: 'cloud', color: '#7cc0ff', items: ['Azure (AZ-900)', 'Docker', 'GitHub Actions', 'Firebase'] },
];

const courses = [
  {
    persona: 'HR / L&D / 學習發展窗口',
    badge: '01',
    title: 'AI 培訓菜單 · 工程師教工程師',
    problem: '老闆說要做 AI 培訓，但你怕找錯講師被工程同事嫌。',
    deliver: [
      '半天 / 一天 / 兩天三種規格，內容客製不是統一講義',
      '給你一份大綱、上課流程、Q&A 預演，可以直接上呈簽核',
      '結訓後給學員一份能帶回工位繼續用的 cheat sheet + 範例 repo',
    ],
    duration: '半天 ～ 兩天',
    tags: ['AI 內訓', 'LLM', 'RAG', '客製大綱'],
  },
  {
    persona: 'CTO / 技術主管 / 工程經理',
    badge: '02',
    title: 'AI 導入顧問 + 內訓套餐',
    problem: '你想推團隊用 AI，但團隊抗拒、不知從哪下手、怕做白工。',
    deliver: [
      '先做場景盤點：哪些痛點適合 AI、哪些不適合，講白話',
      '給可落地的技術選型 + 預算範圍 + 風險清單',
      '內訓 + 雙週 review，讓團隊邊做邊學、不是一場性消費',
    ],
    duration: '單次顧問 ／ 季度合作',
    tags: ['AI 導入', '架構顧問', '場景盤點', 'Workshop'],
  },
  {
    persona: '業務 / PM / 產品主管',
    badge: '03',
    title: '半天 AI 場景 Workshop',
    problem: '你想搞清楚「AI 對我們業務能做什麼、不能做什麼」，又怕被技術名詞繞暈。',
    deliver: [
      '半天 workshop，講白話、不丟英文縮寫',
      '帶著你跟團隊一起列 10-20 個業務場景，現場篩可行性',
      '結束後給一份「下一步該做什麼」的優先級清單',
    ],
    duration: '半天 workshop',
    tags: ['AI 場景盤點', 'PM 友善', '優先級清單'],
  },
];
---

<RootLayout
  title="陳彥彤 YC — 把 AI 真的接到公司系統的 AI 企業內訓講師"
  description="工程師教工程師的 AI 企業內訓與導入顧問。Java 後端 8 年、AI 工程師 2 年。專做 LLM / RAG / Agent 的 production 落地——不是 demo prompt，是要過資安、要長期維運的東西。HR、技術主管、PM 三種對應方案。"
  canonical="/"
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <!-- Hero -->
    <section class="px-6 md:px-10 py-20 md:py-28 border-b-[3px] border-black">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-4 font-mono">
          ai engineer · backend · enterprise training
        </div>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black leading-[1.1] md:leading-[1.05] tracking-tight">
          <span class="block">把 AI 真的接到</span>
          <span class="inline-block mt-2 bg-[var(--color-neub-yellow)] px-2 md:px-3 box-decoration-clone">
            公司系統的人
          </span>
          <span class="block mt-2">現在帶你的團隊也接得上。</span>
        </h1>

        <p class="mt-8 text-lg md:text-xl max-w-3xl leading-relaxed opacity-80">
          我是<strong>陳彥彤 YC</strong>，Java 後端 8 年、AI 工程師 2 年。<br />
          專做工程師教工程師的 AI 企業內訓與導入顧問——不是 demo prompt，是會被資安檢查、要長期維運的東西。
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="#courses"
            class="px-6 py-3 bg-black text-white text-sm uppercase tracking-widest hover:bg-[var(--color-neub-yellow)] hover:text-black transition-colors font-mono"
            style="box-shadow: 4px 4px 0 var(--color-neub-yellow);"
          >
            看內訓方案 →
          </a>
          <a
            href="#contact"
            class="px-6 py-3 bg-[var(--color-neub-yellow)] text-black text-sm uppercase tracking-widest border-2 border-black hover:bg-black hover:text-[var(--color-neub-yellow)] transition-colors font-mono font-black"
          >
            直接聊需求 →
          </a>
          <a
            href={withBase('/blog')}
            class="inline-flex items-center gap-1 px-2 py-3 text-sm uppercase tracking-widest hover:text-black hover:bg-[var(--color-neub-yellow)] transition-colors font-mono underline decoration-black/20 decoration-2 underline-offset-4 hover:decoration-transparent"
          >
            先看技術筆記 →
          </a>
        </div>

        <!-- 信任 strip：一行字打掉「他到底適不適合」的猶豫 -->
        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm md:text-base font-mono opacity-80">
          <span class="flex items-center gap-2"><span class="text-black/50">▸</span> 10-50 場企業內訓累積</span>
          <span class="flex items-center gap-2"><span class="text-black/50">▸</span> Production AI 落地經驗</span>
          <span class="flex items-center gap-2"><span class="text-black/50">▸</span> 工程師看得懂的內容</span>
        </div>

        <!-- Stats -->
        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4">
          {
            stats.map((s, i) => (
              <div
                class:list={[
                  'border-2 border-black px-4 py-5 md:p-6 transition-transform hover:-translate-y-0.5',
                  i === 0 ? 'bg-[var(--color-neub-yellow)]' : 'bg-white',
                ]}
                style="box-shadow: 4px 4px 0 #0a0a0a;"
              >
                <div class="text-2xl md:text-4xl font-black tracking-tight leading-none">
                  {s.number}
                </div>
                <div class="text-xs md:text-sm opacity-70 mt-2 font-mono uppercase tracking-wider">
                  {s.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Signature Work — 讓讀者記住「這個人實際做過的事」 -->
    <section class="relative overflow-hidden border-b-[3px] border-black bg-black text-white">
      <!-- 背景網格（印刷感） -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-[0.08]"
        style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;"
      ></div>

      <div class="relative max-w-7xl mx-auto px-6 md:px-10 py-20">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
          <div>
            <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
              [ why me, not another ai trainer ]
            </div>
            <h2 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1]">
              為什麼找我，<br />而不是<span class="bg-[var(--color-neub-yellow)] text-black px-2">其他 AI 講師</span>？
            </h2>
          </div>
          <p class="text-sm md:text-base leading-relaxed max-w-md opacity-70 font-mono">
            市場上 AI 講師很多。但會寫 production code、又會教書、還在做 AI 落地專案的，沒幾個。
          </p>
        </div>

        <div class="grid gap-0 md:grid-cols-3 border-y-2 border-white/30">
          <div class="p-6 md:p-8 border-b-2 md:border-b-0 md:border-r-2 border-white/30">
            <div class="text-[10px] uppercase tracking-widest opacity-60 font-mono mb-3">
              01 · production code
            </div>
            <div class="text-2xl md:text-3xl font-black leading-tight mb-3">
              我寫過真的<br />會被罵的程式碼
            </div>
            <p class="text-sm opacity-70 leading-relaxed">
              8 年 Java 後端，主責電商核心的 WMS / MOX / MIX 三套系統。
              從架構設計、跨團隊整合到線上事故處理一路走過來。
              <strong class="text-[var(--color-neub-yellow)]">不是只在 sandbox 寫過 demo</strong>，是真的會被 PM 追進度、被 SRE 抓 alert、被資安抓 audit 的那種。
            </p>
          </div>

          <div class="p-6 md:p-8 border-b-2 md:border-b-0 md:border-r-2 border-white/30">
            <div class="text-[10px] uppercase tracking-widest opacity-60 font-mono mb-3">
              02 · ai in production
            </div>
            <div class="text-2xl md:text-3xl font-black leading-tight mb-3">
              我做過真的<br />要長期維運的 AI
            </div>
            <p class="text-sm opacity-70 leading-relaxed">
              近 2 年把 LLM、RAG、Agent 真的接到既有系統的工程實踐。
              <strong class="text-[var(--color-neub-yellow)]">不是 demo prompt</strong>——是要過資安、要接 SSO、要評估成本、要監控品質、要長期維運的東西。教學內容直接用這些經驗當教材。
            </p>
          </div>

          <div class="p-6 md:p-8">
            <div class="text-[10px] uppercase tracking-widest opacity-60 font-mono mb-3">
              03 · engineers teaching engineers
            </div>
            <div class="text-2xl md:text-3xl font-black leading-tight mb-3">
              我教書，<br />但教法是工程師
            </div>
            <p class="text-sm opacity-70 leading-relaxed">
              10-50 場企業內訓累積出來，內容直接打開 IDE / 終端機，
              不走滑面投影片、不發雞湯。
              <strong class="text-[var(--color-neub-yellow)]">工程師會嫌的講師我自己也嫌</strong>——所以這場對得起你工程團隊的時間。
            </p>
          </div>
        </div>

        <!-- 一句差異化 tagline -->
        <div class="mt-10 flex flex-wrap items-center gap-3 text-xs md:text-sm font-mono">
          <span class="inline-block border border-white/40 px-3 py-1 uppercase tracking-wider opacity-80">
            others
          </span>
          <span class="opacity-50">教 prompt、講概念、發投影片</span>
          <span class="opacity-40">/</span>
          <span class="inline-block bg-[var(--color-neub-yellow)] text-black px-3 py-1 uppercase tracking-wider font-bold">
            me
          </span>
          <span class="opacity-90">帶你把 AI 整進公司系統，留下能維運的程式碼</span>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-white">
      <div class="max-w-7xl mx-auto grid gap-12 lg:grid-cols-[1fr_2fr] items-start">
        <div>
          <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
            about me
          </div>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight leading-tight">
            關於我
          </h2>
          <div class="mt-6 inline-block bg-[var(--color-neub-yellow)] px-3 py-1 text-sm font-bold">
            陳彥彤 · Bob Chen
          </div>
        </div>

        <div class="space-y-5 text-base md:text-lg leading-relaxed">
          <p>
            <strong>Java 後端 8 年、AI 工程師 2 年。</strong>
            出身電商核心系統團隊（WMS / MOX / MIX），主責架構設計、跨團隊整合、線上事故處理。
          </p>
          <p>
            近兩年把 LLM、RAG、Agent 真的接到既有系統裡——
            <strong>要過資安、要接 SSO、要評估成本、要監控品質、要長期維運。</strong>
            這些落地經驗整理成教材，帶 AI / 前後端 / 雲端三條線的企業內訓，也接 AI 導入的顧問案。
          </p>
          <p class="text-base opacity-75 italic border-l-4 border-black pl-4">
            我不是「以前是工程師現在轉講師」——我是<strong>邊做專案邊教書的工程師</strong>，
            這也是為什麼我的教材永遠跟得上工程現場。
          </p>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-4">
            {
              [
                { title: 'AI 工程', desc: 'LLM · RAG · Agent' },
                { title: '後端專精', desc: 'Spring Boot · Java 8 年' },
                { title: '企業內訓', desc: '10-50 場累積' },
                { title: 'AI 顧問', desc: 'AI 導入專案' },
              ].map((i) => (
                <div class="border-2 border-black p-3">
                  <div class="font-black text-sm">{i.title}</div>
                  <div class="text-xs opacity-70 mt-1">{i.desc}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="px-6 md:px-10 py-20 border-b-[3px] border-black">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
          tech stack
        </div>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-10">
          技術專長
        </h2>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {
            skills.map((s) => (
              <div
                class="border-2 border-black bg-white overflow-hidden"
                style="box-shadow: 4px 4px 0 #0a0a0a;"
              >
                <div
                  class="px-5 py-3 border-b-2 border-black flex items-center justify-between font-mono"
                  style={`background: ${s.color};`}
                >
                  <span class="text-lg font-black">{s.group}</span>
                  <span class="text-[10px] uppercase tracking-widest opacity-70">
                    {s.label}
                  </span>
                </div>
                <ul class="p-5 space-y-2 text-sm font-bold">
                  {s.items.map((it) => (
                    <li class="flex items-start gap-2">
                      <span class="text-black/40 select-none">▸</span>
                      <span>{it}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Courses -->
    <section id="courses" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
          who are you · 對應方案
        </div>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight mb-3">
          告訴我你是誰，<br class="md:hidden" />我給你對應方案
        </h2>
        <p class="text-sm md:text-base opacity-70 max-w-3xl leading-relaxed mb-10">
          下面三種角色找我的需求最常見。挑一張像你的卡片，直接點下方 CTA 寄信，<strong>主旨已經幫你寫好</strong>。
        </p>

        <div class="grid gap-6 md:grid-cols-3">
          {
            courses.map((c) => (
              <div
                class="relative border-2 border-black bg-white p-6 flex flex-col"
                style="box-shadow: 6px 6px 0 #0a0a0a;"
              >
                <div
                  class="absolute -top-3 -left-3 px-2 py-0.5 text-xs font-black uppercase border-2 border-black font-mono bg-[var(--color-neub-yellow)]"
                >
                  {c.badge}
                </div>
                <div class="text-[11px] uppercase tracking-widest opacity-70 mb-2 font-mono">
                  if you are
                </div>
                <div class="text-base font-black mb-4 leading-tight">
                  {c.persona}
                </div>
                <h3 class="text-xl font-black leading-tight mb-3 border-t-2 border-black pt-4">
                  {c.title}
                </h3>
                <p class="text-sm leading-relaxed opacity-80 mb-4">
                  <strong>你的痛：</strong>{c.problem}
                </p>
                <div class="text-[11px] uppercase tracking-widest opacity-60 mb-2 font-mono">
                  我給你
                </div>
                <ul class="space-y-2 text-sm mb-5 flex-1">
                  {c.deliver.map((d) => (
                    <li class="flex items-start gap-2 leading-relaxed">
                      <span class="text-black/40 select-none">▸</span>
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
                <div class="border-t-2 border-black pt-3 mt-auto flex items-center justify-between text-xs font-mono">
                  <span class="opacity-70">時長：<strong>{c.duration}</strong></span>
                  <a
                    href={`mailto:bobchen184@gmail.com?subject=${encodeURIComponent(`[${c.persona}] 想聊聊 ${c.title}`)}&body=${encodeURIComponent(`嗨 YC，\n\n我是 ___（公司／團隊）___ 的 ${c.persona}。\n\n• 目前情境：\n• 想解決的問題：\n• 預期時程：\n• 大概人數 / 預算範圍：\n\n謝謝！`)}`}
                    class="font-black uppercase tracking-widest hover:underline"
                  >
                    寄信聊 →
                  </a>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Anti-pitch：什麼案子我不接 -->
        <div class="mt-12 border-2 border-dashed border-black p-6 bg-[#fafaf6]">
          <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
            transparency · 我不接什麼案
          </div>
          <h3 class="text-xl md:text-2xl font-black leading-tight mb-3">
            為了不浪費你的時間 — 這幾種案我會婉拒
          </h3>
          <ul class="grid gap-2 md:grid-cols-2 text-sm leading-relaxed">
            <li class="flex items-start gap-2"><span class="text-black/40">✗</span><span>「明天就要上、預算先不談」的急件——做不出對得起你的東西</span></li>
            <li class="flex items-start gap-2"><span class="text-black/40">✗</span><span>「想找講師講 AI 概論抵 ESG 學分」——我不擅長雞湯場</span></li>
            <li class="flex items-start gap-2"><span class="text-black/40">✗</span><span>「保證讓我們做出 ChatGPT 級產品」——做不到的事我不接</span></li>
            <li class="flex items-start gap-2"><span class="text-black/40">✗</span><span>「希望講師全程不寫程式」——我寫程式才是這場的價值</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <Testimonials />

    <!-- Latest Posts -->
    {
      latest.length > 0 && (
        <section class="px-6 md:px-10 py-20 border-b-[3px] border-black">
          <div class="max-w-7xl mx-auto">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 mb-10">
              <div>
                <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
                  latest posts
                </div>
                <h2 class="text-3xl md:text-4xl font-black tracking-tight">
                  最新文章
                </h2>
              </div>
              <a
                href={withBase('/blog')}
                class="self-start sm:self-auto text-xs uppercase tracking-widest underline font-mono hover:bg-[var(--color-neub-yellow)] px-1"
              >
                all posts →
              </a>
            </div>

            <div
              class:list={[
                'grid gap-0 border-t-2 border-black',
                latest.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2',
              ]}
            >
              {latest.map((p, i) => (
                <a
                  href={withBase(`/blog/${p.slug}`)}
                  class:list={[
                    'block p-6 border-b-2 border-black hover:bg-[var(--color-neub-yellow)] transition-colors',
                    i < latest.length - 1 ? 'md:border-r-2' : '',
                  ]}
                >
                  <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
                    [{p.category}] · {formatDate(p.publishDate)}
                  </div>
                  <h3 class="text-lg font-black leading-tight mb-2">{p.title}</h3>
                  <p class="text-sm opacity-70 line-clamp-2">{p.excerpt}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

