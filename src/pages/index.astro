---
/**
 * / — 形象首頁（Hero → 關於 → 技能棧 → 課程 → 最新文章 → 聯繫）
 * 保留 Neub 風格底但移除 /// // 裝飾前綴。
 */
import RootLayout from '../layouts/RootLayout.astro';
import NavbarNeub from '../components/NavbarNeub.astro';
import FooterNeub from '../components/FooterNeub.astro';
import Testimonials from '../sections/Testimonials.astro';
import MessageBoard from '../components/MessageBoard.tsx';
import { getAllPublishedPosts } from '../lib/firestore';
import { withBase } from '../lib/url';

const posts = await getAllPublishedPosts();
const latest = posts.slice(0, 3);
const formatDate = (d: string) => d.replaceAll('-', '/');

const stats = [
  { number: '3+', label: 'Production AI 專案' },
  { number: '10-50', label: '場企業內訓' },
  { number: 'Java + AI', label: '雙棧背景' },
  { number: 'AZ-900', label: 'Azure 認證' },
];

const productionCases = [
  {
    domain: '醫療領域',
    title: '決策輔助系統的反饋學習機制',
    body: 'AI 模型隨臨床實際使用持續修正的閉環設計——讓模型不是上線就停在那，而是真的越用越準。',
    tags: ['Feedback Loop', '模型迭代', 'Production AI'],
    color: '#ff6ec7',
  },
  {
    domain: '企業語音辨識',
    title: '用聯發科 Breeze-ASR-25 落地',
    body: '協助企業導入繁體中文語音辨識（基於聯發科開源 ASR 模型），含部署、領域術語調教、品質監控。不只 OpenAI Whisper，本土模型也能落地。',
    tags: ['Breeze-ASR-25', '繁中語音', '企業部署'],
    color: '#ffaa00',
  },
  {
    domain: '企業內部',
    title: '會議記錄 RAG 檢索',
    body: '跨部門會議檔的向量檢索與語意問答，含 ACL 權限切割——不同角色看到不同會議，不靠 prompt 攔截，靠 retrieval 層先過濾。',
    tags: ['RAG', '向量檢索', 'ACL 權限'],
    color: '#7cc0ff',
  },
];

const faqs: { q: string; a: string }[] = [
  {
    q: '收費怎麼算？我能先知道大概價格嗎？',
    a: '我不公開固定報價。原因是內訓 / 顧問差異很大——半天 PM workshop 跟兩天工程師深度班、全客製大綱跟既有教材微調，價格會差好幾倍。先聊 30 分鐘了解你的規模、對象、客製程度，我這邊一兩天內給你準確報價區間，不會有「先聊聊再追加」的狀況。',
  },
  {
    q: '客製化流程是怎麼運作的？',
    a: '收到你的需求後我會回一份「課前訪談題庫」（你們團隊現在用什麼、痛點是什麼、想學完做什麼），約一次 30-60 分鐘對焦會議，之後產出客製大綱給你內部簽核。簽核通過後我才開始備課、寫範例 repo。',
  },
  {
    q: '線上 / 實體都可以嗎？',
    a: '都可以。實體：北中南都跑過。線上：用 Google Meet / Teams / Webex 都行。混合（部分人實體 + 部分人線上）也接，但我會建議你選一邊比較好——同時招呼兩邊體驗會打折。',
  },
  {
    q: '可以開公司發票嗎？流程？',
    a: '可以。我有公司行號，能開二聯 / 三聯發票。確認需求後我會發報價單，你內部簽核完回傳，課後 7 個工作日內開立發票。月結 30 / 60 也都接受。',
  },
  {
    q: '臨時要取消怎麼辦？',
    a: '7 天前取消無條件全額退；3-7 天取消收 50%；3 天內取消收全額（因為備課與檔期都已投入）。延期則完全沒問題，只要找得到雙方都 OK 的新檔期。',
  },
  {
    q: '我們團隊很小（5 人以下），划得來嗎？',
    a: '划得來。小團隊我反而能做更貼身的內容——直接看你們真實 codebase、真實痛點、真實工作流，不是發通用講義。報價我會用較合理的小團體價，不要因為人少就放棄這件事。',
  },
  {
    q: '資料 / 程式碼隱私怎麼處理？',
    a: '我簽 NDA。教學用例會匿名化（公司名替換、敏感欄位脫敏）。如果你們希望課後我這邊不留任何材料副本，課後我會清空相關檔案。',
  },
  {
    q: '結訓後團隊還能繼續問問題嗎？',
    a: '可以。基本款：結訓後一個月內 email / Slack 群組 Q&A 不額外收費。延伸方案：雙週 review 顧問合作，做完一場內訓後最常被選的後續方案。',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

const skills = [
  { group: 'AI', label: 'ai', color: '#ffaa00', items: ['LLM 應用', 'RAG', 'Agent', '語音辨識', 'Prompt 設計'] },
  { group: '後端', label: 'backend', color: 'var(--color-neub-yellow)', items: ['Spring Boot 4', 'Java 21', 'Maven', 'JPA / Hibernate'] },
  { group: '資料', label: 'data', color: '#00ffd1', items: ['MySQL', 'MSSQL', 'Redis', 'RabbitMQ'] },
  { group: '前端', label: 'frontend', color: '#ff6ec7', items: ['React 19', 'TypeScript', 'Vite', 'Tailwind CSS'] },
  { group: '雲端', label: 'cloud', color: '#7cc0ff', items: ['Azure (AZ-900)', 'Docker', 'GitHub Actions', 'Firebase'] },
];

const courses = [
  {
    persona: 'HR / L&D / 學習發展窗口',
    badge: '01',
    title: 'AI 培訓菜單 · 工程師教工程師',
    problem: '老闆說要做 AI 培訓，但你怕找錯講師被工程同事嫌。',
    deliver: [
      '半天 / 一天 / 兩天三種規格，內容客製不是統一講義',
      '給你一份大綱、上課流程、Q&A 預演，可以直接上呈簽核',
      '結訓後給學員一份能帶回工位繼續用的 cheat sheet + 範例 repo',
    ],
    duration: '半天 ～ 兩天',
    tags: ['AI 內訓', 'LLM', 'RAG', '客製大綱'],
  },
  {
    persona: 'CTO / 技術主管 / 工程經理',
    badge: '02',
    title: 'AI 導入顧問 + 內訓套餐',
    problem: '你想推團隊用 AI，但團隊抗拒、不知從哪下手、怕做白工。',
    deliver: [
      '先做場景盤點：哪些痛點適合 AI、哪些不適合，講白話',
      '給可落地的技術選型 + 預算範圍 + 風險清單',
      '內訓 + 雙週 review，讓團隊邊做邊學、不是一場性消費',
    ],
    duration: '單次顧問 ／ 季度合作',
    tags: ['AI 導入', '架構顧問', '場景盤點', 'Workshop'],
  },
  {
    persona: '業務 / PM / 產品主管',
    badge: '03',
    title: '半天 AI 場景 Workshop',
    problem: '你想搞清楚「AI 對我們業務能做什麼、不能做什麼」，又怕被技術名詞繞暈。',
    deliver: [
      '半天 workshop，講白話、不丟英文縮寫',
      '帶著你跟團隊一起列 10-20 個業務場景，現場篩可行性',
      '結束後給一份「下一步該做什麼」的優先級清單',
    ],
    duration: '半天 workshop',
    tags: ['AI 場景盤點', 'PM 友善', '優先級清單'],
  },
];
---

<RootLayout
  title="陳彥彤 YC — 把 AI 真的接到公司系統的 AI 企業內訓講師"
  description="工程師教工程師的 AI 企業內訓與導入顧問。Java 後端 8 年、AI 工程師 2 年。專做 LLM / RAG / Agent 的 production 落地——醫療決策輔助、企業語音辨識（Breeze-ASR-25）、會議 RAG 三個真實案例。HR、技術主管、PM 三種對應方案。"
  canonical="/"
  jsonLd={faqJsonLd}
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <!-- Hero -->
    <section class="px-6 md:px-10 py-20 md:py-28 border-b-[3px] border-black">
      <div class="max-w-7xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-4 font-mono">
          ai consultant · enterprise training · production-ready
        </div>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black leading-[1.1] md:leading-[1.05] tracking-tight">
          <span class="block">把 AI 真的接到</span>
          <span class="inline-block mt-2 bg-[var(--color-neub-yellow)] px-2 md:px-3 box-decoration-clone">
            公司系統的人
          </span>
          <span class="block mt-2">現在帶你的團隊也接得上。</span>
        </h1>

        <p class="mt-8 text-lg md:text-xl max-w-3xl leading-relaxed opacity-80">
          我是<strong>陳彥彤 YC</strong>。專做<strong>會被資安檢查、要長期維運</strong>的 AI 企業內訓與導入顧問。<br class="hidden md:inline" />
          醫療決策輔助、企業語音辨識、會議 RAG——三個 production 專案的工程實踐，直接帶到你的內訓現場。
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="#contact"
            class="px-6 py-3 bg-[var(--color-neub-yellow)] text-black text-sm uppercase tracking-widest border-2 border-black hover:bg-black hover:text-[var(--color-neub-yellow)] transition-colors font-mono font-black"
            style="box-shadow: 4px 4px 0 #0a0a0a;"
          >
            聊聊你的需求 →
          </a>
          <a
            href="#production"
            class="text-sm uppercase tracking-widest font-mono underline decoration-black/30 decoration-2 underline-offset-4 hover:bg-[var(--color-neub-yellow)] px-1 transition-colors"
          >
            先看落地經驗
          </a>
        </div>

        <!-- 信任 strip：一行字打掉「他到底適不適合」的猶豫 -->
        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm md:text-base font-mono opacity-80">
          <span class="flex items-center gap-2"><span class="text-black/50">▸</span> 醫療 / 語音 / RAG 三個 production AI 專案</span>
          <span class="flex items-center gap-2"><span class="text-black/50">▸</span> 10-50 場企業內訓累積</span>
          <span class="flex items-center gap-2"><span class="text-black/50">▸</span> 工程師教工程師的內容</span>
        </div>

        <!-- Stats -->
        <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4">
          {
            stats.map((s, i) => (
              <div
                class:list={[
                  'border-2 border-black px-4 py-5 md:p-6 transition-transform hover:-translate-y-0.5',
                  i === 0 ? 'bg-[var(--color-neub-yellow)]' : 'bg-white',
                ]}
                style="box-shadow: 4px 4px 0 #0a0a0a;"
              >
                <div class="text-2xl md:text-4xl font-black tracking-tight leading-none">
                  {s.number}
                </div>
                <div class="text-xs md:text-sm opacity-70 mt-2 font-mono uppercase tracking-wider">
                  {s.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Signature Work — 讓讀者記住「這個人實際做過的事」 -->
    <section class="relative overflow-hidden border-b-[3px] border-black bg-black text-white">
      <!-- 背景網格（印刷感） -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-[0.08]"
        style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;"
      ></div>

      <div class="relative max-w-7xl mx-auto px-6 md:px-10 py-20">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
          <div>
            <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
              [ why me, not another ai trainer ]
            </div>
            <h2 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1]">
              為什麼找我，<br />而不是<span class="bg-[var(--color-neub-yellow)] text-black px-2">其他 AI 講師</span>？
            </h2>
          </div>
          <p class="text-sm md:text-base leading-relaxed max-w-md opacity-70 font-mono">
            市場上 AI 講師很多。但會寫 production code、又會教書、還在做 AI 落地專案的，沒幾個。
          </p>
        </div>

        <div class="grid gap-0 md:grid-cols-3 border-y-2 border-white/30">
          <div class="p-6 md:p-8 border-b-2 md:border-b-0 md:border-r-2 border-white/30">
            <div class="text-[10px] uppercase tracking-widest opacity-60 font-mono mb-3">
              01 · production code
            </div>
            <div class="text-2xl md:text-3xl font-black leading-tight mb-3">
              我寫過真的<br />會被罵的程式碼
            </div>
            <p class="text-sm opacity-70 leading-relaxed">
              8 年 Java 後端，主責電商核心的 WMS / MOX / MIX 三套系統。
              從架構設計、跨團隊整合到線上事故處理一路走過來。
              <strong class="text-[var(--color-neub-yellow)]">不是只在 sandbox 寫過 demo</strong>，是真的會被 PM 追進度、被 SRE 抓 alert、被資安抓 audit 的那種。
            </p>
          </div>

          <div class="p-6 md:p-8 border-b-2 md:border-b-0 md:border-r-2 border-white/30">
            <div class="text-[10px] uppercase tracking-widest opacity-60 font-mono mb-3">
              02 · ai in production
            </div>
            <div class="text-2xl md:text-3xl font-black leading-tight mb-3">
              我做過真的<br />要長期維運的 AI
            </div>
            <p class="text-sm opacity-70 leading-relaxed">
              近 2 年把 LLM、RAG、Agent 真的接到既有系統的工程實踐——
              要過資安、要接 SSO、要評估成本、要監控品質、要<strong class="text-[var(--color-neub-yellow)]">長期維運</strong>。
              教學內容直接用這些經驗當教材。
            </p>
          </div>

          <div class="p-6 md:p-8">
            <div class="text-[10px] uppercase tracking-widest opacity-60 font-mono mb-3">
              03 · engineers teaching engineers
            </div>
            <div class="text-2xl md:text-3xl font-black leading-tight mb-3">
              我教書，<br />但教法是工程師
            </div>
            <p class="text-sm opacity-70 leading-relaxed">
              10-50 場企業內訓累積出來，內容直接打開 IDE / 終端機，
              不走滑面投影片、不發雞湯。
              <strong class="text-[var(--color-neub-yellow)]">工程師會嫌的講師我自己也嫌</strong>——所以這場對得起你工程團隊的時間。
            </p>
          </div>
        </div>

        <!-- 一句差異化 tagline -->
        <div class="mt-10 flex flex-wrap items-center gap-3 text-xs md:text-sm font-mono">
          <span class="inline-block border border-white/40 px-3 py-1 uppercase tracking-wider opacity-80">
            others
          </span>
          <span class="opacity-50">教 prompt、講概念、發投影片</span>
          <span class="opacity-40">/</span>
          <span class="inline-block bg-[var(--color-neub-yellow)] text-black px-3 py-1 uppercase tracking-wider font-bold">
            me
          </span>
          <span class="opacity-90">帶你把 AI 整進公司系統，留下能維運的程式碼</span>
        </div>
      </div>
    </section>

    <!-- Production AI 落地經驗 — 真實案例 -->
    <section id="production" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
          <div>
            <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
              production ai cases · 落地經驗
            </div>
            <h2 class="text-3xl md:text-5xl font-black tracking-tight leading-[1.1]">
              我做過的 AI 不是 demo——<br />是<span class="bg-[var(--color-neub-yellow)] px-2">真的上線在跑</span>的東西
            </h2>
          </div>
          <p class="text-sm md:text-base leading-relaxed max-w-md opacity-70">
            下面三個是我實際做過、教學現場可直接拆解的案例。
            細節為配合 NDA 已抽象化，但工程實踐是真的。
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {
            productionCases.map((p) => (
              <article
                class="border-2 border-black bg-white p-6 flex flex-col"
                style="box-shadow: 6px 6px 0 #0a0a0a;"
              >
                <div
                  class="inline-block self-start px-2 py-0.5 text-[11px] uppercase tracking-widest font-mono font-black mb-4 border-2 border-black"
                  style={`background: ${p.color};`}
                >
                  {p.domain}
                </div>
                <h3 class="text-xl md:text-2xl font-black leading-tight mb-4">
                  {p.title}
                </h3>
                <p class="text-sm leading-relaxed opacity-80 mb-5 flex-1">
                  {p.body}
                </p>
                <div class="flex flex-wrap gap-1.5 pt-4 border-t-2 border-black">
                  {p.tags.map((t) => (
                    <span class="text-[11px] font-mono px-2 py-0.5 border border-black/40 opacity-80">
                      #{t}
                    </span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        <p class="mt-8 text-sm md:text-base font-mono opacity-70 max-w-3xl leading-relaxed">
          ▸ 想知道某個案例怎麼操作的？我可以在內訓現場拆給你工程團隊看——包含當時的選型、踩到的坑、最後怎麼結。
        </p>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="px-6 md:px-10 py-20 border-b-[3px] border-black bg-white">
      <div class="max-w-7xl mx-auto grid gap-12 lg:grid-cols-[1fr_2fr] items-start">
        <div>
          <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
            about me
          </div>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight leading-tight">
            關於我
          </h2>
          <div class="mt-6 inline-block bg-[var(--color-neub-yellow)] px-3 py-1 text-sm font-bold">
            陳彥彤 · Bob Chen
          </div>
        </div>

        <div class="space-y-5 text-base md:text-lg leading-relaxed">
          <p>
            <strong>Java 後端 8 年、AI 工程師 2 年。</strong>
            出身電商核心系統團隊（WMS / MOX / MIX），主責架構設計、跨團隊整合、線上事故處理。
          </p>
          <p>
            近兩年把 LLM、RAG、Agent 真的接到既有系統裡——醫療決策輔助系統的反饋學習機制、
            用聯發科 Breeze-ASR-25 做的繁中企業語音辨識、跨部門會議的 RAG 檢索（含 ACL 權限切割）。
            <strong>要過資安、要接 SSO、要評估成本、要監控品質、要長期維運。</strong>
            這些落地經驗整理成教材，帶 AI / 前後端 / 雲端三條線的企業內訓，也接 AI 導入的顧問案。
          </p>
          <p class="text-base opacity-75 italic border-l-4 border-black pl-4">
            我不是「以前是工程師現在轉講師」——我是<strong>邊做專案邊教書的工程師</strong>，
            這也是為什麼我的教材永遠跟得上工程現場。
          </p>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-4">
            {
              [
                { title: 'AI 工程', desc: 'LLM · RAG · Agent' },
                { title: '後端專精', desc: 'Spring Boot · Java 8 年' },
