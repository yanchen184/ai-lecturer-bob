---
/**
 * 站點最外層 HTML 外殼。
 * - SEO meta / OG / Twitter Card
 * - Google Fonts
 * - 全域 CSS
 * - JSON-LD（Person schema）
 *
 * 使用方式：
 *   <RootLayout title="..." description="..." canonical="/blog">
 *     ...content
 *   </RootLayout>
 */
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** 頁面相對路徑，如 `/blog`；不傳則用 Astro.url.pathname */
  canonical?: string;
  /** OG image 相對或絕對網址 */
  ogImage?: string;
  /** 額外 JSON-LD（會與預設 Person schema 並存） */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** true = 禁止索引（如 /admin） */
  noindex?: boolean;
}

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '';

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.png',
  jsonLd,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
// base 會是 `/ai-lecturer-bob`（project page）或 ''（user page / 自訂網域）
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 把相對路徑 prepend base；絕對 URL（http/https）不動
const withBase = (p: string): string =>
  /^https?:\/\//.test(p) ? p : `${base}${p.startsWith('/') ? '' : '/'}${p}`;

const pathInput = canonical ?? (Astro.url.pathname.replace(base, '') || '/');
const normalizeCanonicalPath = (path: string): string => {
  if (/^https?:\/\//.test(path)) return path;
  const [pathname, suffix = ''] = path.split(/(?=[?#])/);
  if (pathname === '/' || pathname.endsWith('/') || /\/[^/]+\.[^/]+$/.test(pathname)) return path;
  return `${pathname}/${suffix}`;
};
const normalizedCanonical = normalizeCanonicalPath(pathInput);
const canonicalUrl = /^https?:\/\//.test(normalizedCanonical)
  ? normalizedCanonical
  : `${siteUrl}${withBase(normalizedCanonical)}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${withBase(ogImage)}`;
const rssUrl = `${siteUrl}${withBase('/rss.xml')}`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '陳彥彤 Bob Chen',
  alternateName: [
    '陳彥彤YC',
    '陳彥彤',
    'YC',
    'Bob Chen',
    'bobchen',
    'yanchen',
    'Yanchen Chen',
    'yanchen184',
    'bobchen184',
  ],
  jobTitle: 'AI 企業內訓講師 · AI 顧問 · 資深 Java 後端工程師',
  description:
    '工程師教工程師的 AI 企業內訓與導入顧問。電商核心系統 8 年高併發實戰、近年主導醫療 AI 看診輔助平台落地。Claude Code、AI Agent、Kubernetes、Java 高併發內訓主力。',
  url: `${siteUrl}${withBase('/')}`,
  sameAs: ['https://github.com/yanchen184'],
  knowsAbout: [
    'AI 企業內訓',
    'Claude Code',
    'AI Agent',
    'LLM 應用',
    'RAG',
    'Multi-Agent 系統',
    'Spring Boot',
    'Java 高併發',
    'Kubernetes',
    'Docker',
    'React',
    'TypeScript',
    'Azure',
    '電商系統架構',
    '微服務',
  ],
  knowsLanguage: ['zh-Hant', 'en'],
};

const allJsonLd = Array.isArray(jsonLd)
  ? [personSchema, ...jsonLd]
  : jsonLd
  ? [personSchema, jsonLd]
  : [personSchema];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Theme init (FOUC prevention) — 必須在 CSS / body 之前執行 -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('site-theme');
          if (t === 'anti') {
            document.documentElement.setAttribute('data-theme', 'anti');
          }
        } catch (_) {}
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="陳彥彤 YC · AI 顧問" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="zh_TW" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 字型精簡：只留實際用到的 Space Grotesk + JetBrains Mono + Noto Sans TC
         用 media=print + onload hack 讓 CSS 非阻塞（LCP 優化） -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@500;700&display=swap"
      />
    </noscript>

    <link
      rel="alternate"
      type="application/rss+xml"
      title="陳彥彤 YC · AI 顧問 — 部落格"
      href={rssUrl}
    />

    {
      allJsonLd.map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
  </head>
  <body class="bg-[var(--color-neub-bg)]">
    <slot />
    {!noindex && (
      <script>
        import { trackVisitor, trackOutboundClick } from '../lib/firebase-client';

        // 1) 訪客追蹤（requestIdleCallback 避免卡首屏）
        const fire = () => trackVisitor();
        if ('requestIdleCallback' in window) {
          (window as any).requestIdleCallback(fire, { timeout: 2000 });
        } else {
          setTimeout(fire, 1000);
        }

        // 2) 外連點擊追蹤（事件委派，全站 <a> 都攔得到）
        document.addEventListener(
          'click',
          (e) => {
            const a = (e.target as HTMLElement | null)?.closest('a');
            if (!a) return;
            const href = a.getAttribute('href') || '';
            if (!href) return;

            const isMail = href.startsWith('mailto:');
            const isTel = href.startsWith('tel:');
            const isExternal =
              /^https?:\/\//i.test(href) &&
              !href.includes(window.location.hostname);

            if (!isMail && !isTel && !isExternal) return;

            trackOutboundClick({
              url: href,
              label: (a.textContent || '').trim().slice(0, 50),
              fromPath: window.location.pathname,
            });
          },
          { capture: true }
        );
      </script>
    )}
  </body>
</html>
