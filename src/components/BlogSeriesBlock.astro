---
/**
 * 系列文章區塊 — Neub 風格折疊列表。
 *
 * 用法：在 /blog 首頁的「全部文章」上方放一塊「閱讀系列」,把
 * Hermes、Claude Code 等 series 集中露出,讓讀者從第一篇開始讀。
 *
 * 視覺與 K8s 教學系列保持一致(同樣的 `<details>` 折疊樣式),
 * 但用 series.ts 定義的 SeriesGroup 資料驅動。
 */
import type { SeriesGroup } from '../lib/series';
import { withBase } from '../lib/url';

interface Props {
  group: SeriesGroup;
  /** 預設展開的系列 key（通常是第一個或最熱門那個） */
  defaultOpen?: boolean;
}

const { group, defaultOpen = false } = Astro.props;
const { meta, posts } = group;
const formatDate = (d: string) => d.replaceAll('-', '/');
---

<details
  class="border-2 border-black bg-white mb-4 group/series"
  open={defaultOpen}
  id={`series-${meta.key}`}
>
  <summary class="cursor-pointer list-none p-4 md:p-5 flex items-center justify-between gap-4 hover:bg-[var(--color-neub-yellow)] transition-colors border-b-2 border-black">
    <div class="min-w-0">
      <div class="text-[11px] uppercase tracking-widest font-mono opacity-60 mb-1 flex items-center gap-2">
        <span>series</span>
        <span class="opacity-40">·</span>
        <span class="font-black">{posts.length.toString().padStart(2, '0')} 篇</span>
      </div>
      <div class="text-lg md:text-xl font-black tracking-tight truncate">
        {meta.label}
      </div>
    </div>
    <span
      class="text-2xl font-black flex-shrink-0 transition-transform duration-200 ease-out group-open/series:rotate-45"
      aria-hidden="true"
    >+</span>
  </summary>

  <div class="p-4 md:p-5">
    <p class="text-sm md:text-base leading-relaxed opacity-80 mb-5">
      {meta.description}
    </p>

    <ol class="list-none p-0 m-0 border-2 border-black bg-white">
      {posts.map((post, idx) => (
        <li class="border-b-2 border-black last:border-b-0">
          <a
            href={withBase(`/blog/${post.slug}`)}
            class="flex items-baseline gap-3 p-3 hover:bg-[var(--color-neub-yellow)] transition-colors"
          >
            <span class="text-xs font-mono opacity-50 w-7 flex-shrink-0 font-black">
              {(idx + 1).toString().padStart(2, '0')}
            </span>
            <span class="flex-1 min-w-0">
              <span class="block font-black leading-snug truncate">
                {post.title}
              </span>
              <span class="block text-[11px] font-mono opacity-60 mt-0.5">
                {formatDate(post.publishDate)} · {post.readingTime} min
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</details>
