---
/**
 * Neub 風格 Navbar（SSR 友善、純 CSS 可展開手機選單）。
 * - md+ : 左側固定全高「深色」垂直側欄（Logo 在上、編號導覽、底部社群 + 版權），
 *         對齊 design-targets/refined-neub-* 風格。主內容由 body padding-left 讓位。
 * - < md: 頂部 sticky bar，Logo 左、hamburger 右，點開後以 <details> 展開全部連結。
 * - currentPath 用於高亮 active link
 */
import { withBase, base } from '../lib/url';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  currentPath?: string;
  /**
   * 側欄版型:
   * - 'dark'（預設）：深色編號導覽 + STATUS 框（對齊 refined-neub-homepage）
   * - 'light'：淺底「YAN CHEN 大字 + 頭像 + 訂閱框」（對齊 refined-neub-blog-index）
   */
  variant?: 'dark' | 'light';
}
const variant = Astro.props.variant ?? 'light';
const rawPath = Astro.props.currentPath ?? Astro.url.pathname;
const currentPath = rawPath.startsWith(base)
  ? rawPath.slice(base.length) || '/'
  : rawPath;

const navItems = [
  { label: '首頁', en: 'home', href: '/' },
  { label: '關於我', en: 'about', href: '/#about' },
  { label: '企業內訓', en: 'training', href: '/#courses' },
  { label: '技術專長', en: 'skills', href: '/#skills' },
  { label: '作品與案例', en: 'work', href: '/#portfolio' },
  { label: '文章與分享', en: 'blog', href: '/blog' },
  { label: '活動與課程', en: 'events', href: '/#production' },
  { label: '聯絡我', en: 'contact', href: '/#contact' },
] as const;

// light variant 用的 outline icon（對齊 blog-index 目標的線條圖示），順序對齊 navItems
const navIcons = [
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5M5 10v10h14V10"/></svg>',
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>',
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5zM6 12v5c0 1 2.7 2.5 6 2.5s6-1.5 6-2.5v-5"/></svg>',
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 8-5 4 5 4M15 8l5 4-5 4"/></svg>',
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 9h18M8 4v16"/></svg>',
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="1"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>',
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="1"/><path d="m2 6 10 7L22 6"/></svg>',
];

const isActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};

const resolveHref = (href: string) =>
  href.startsWith('/#') ? withBase('/') + href.slice(1) : withBase(href);
---

<!-- ============ md+ : 左側固定全高「深色」垂直側欄（variant=dark） ============ -->
{variant === 'dark' && (
<nav
  class="site-sidebar hidden md:flex md:flex-col fixed left-0 top-0 z-40 h-screen bg-[#0a0a0a] text-white border-r-[3px] border-black"
  aria-label="主要導覽"
>
  <!-- Logo 區 -->
  <a
    href={withBase('/')}
    class="flex items-center gap-2.5 px-4 py-4 border-b-2 border-white/15 hover:bg-white/5 transition-colors group"
    aria-label="回到首頁"
  >
    <span
      class="w-9 h-9 inline-flex items-center justify-center bg-[var(--color-neub-yellow)] border-2 border-black shrink-0 text-black font-black text-[15px] tracking-tighter leading-none"
      aria-hidden="true"
    >YC</span>
    <span class="min-w-0">
      <span class="block text-sm font-black tracking-tight leading-none">YC / BOB CHEN</span>
      <span class="block text-[10px] font-mono uppercase tracking-[0.2em] text-white/45 mt-1 truncate">AI 講師 · 全端開發者</span>
    </span>
  </a>

  <!-- NAVIGATION 標題 -->
  <div class="px-4 pt-5 pb-2">
    <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-white/35">navigation</span>
  </div>

  <!-- 編號導覽列 -->
  <div class="flex-1 flex flex-col gap-1 px-3 text-sm font-mono overflow-y-auto neub-scrollbar">
    {
      navItems.map((item, i) => (
        <a
          href={resolveHref(item.href)}
          class:list={[
            'flex items-center justify-between gap-3 px-3 py-3 border-2 transition-colors',
            isActive(item.href)
              ? 'bg-[var(--color-neub-yellow)] text-black border-black'
              : 'border-transparent text-white/85 hover:bg-white/8 hover:border-white/20',
          ]}
        >
          <span class="flex items-center gap-2.5">
            <span class:list={['inline-flex items-center justify-center w-5 h-5 shrink-0', isActive(item.href) ? 'text-black' : 'text-white/55']} aria-hidden="true">
              <span class="w-1.5 h-1.5 bg-current inline-block"></span>
            </span>
            <span class="tracking-wide">{item.label}</span>
          </span>
          <span class:list={['text-[10px] tabular-nums shrink-0', isActive(item.href) ? 'text-black/55' : 'text-white/30']}>
            {String(i + 1).padStart(2, '0')}
          </span>
        </a>
      ))
    }
  </div>

  <!-- STATUS 區塊（對齊目標圖 AVAILABLE） -->
  <div class="px-3 pb-3">
    <div class="border-2 border-white/25 bg-white/[0.03] px-3 py-2.5">
      <div class="text-[9px] font-mono uppercase tracking-[0.25em] text-white/35 mb-1.5">STATUS</div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 bg-[#4ade80] inline-block shrink-0"></span>
        <span class="text-[10px] font-mono uppercase tracking-widest text-white/80 leading-tight">
          AVAILABLE<br />FOR TRAINING / PROJECT
        </span>
      </div>
    </div>
  </div>

  <!-- 底部：社群 + 主題切換 + 版權 -->
  <div class="border-t-2 border-white/15">
    <!-- 社群 icon 列 -->
    <div class="flex items-stretch border-b-2 border-white/15">
      <a
        href="https://github.com/yanchen184"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="flex-1 flex items-center justify-center py-3 text-white/60 hover:text-black hover:bg-[var(--color-neub-yellow)] transition-colors border-r-2 border-white/15"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.25.82-.57v-2c-3.34.71-4.04-1.58-4.04-1.58-.55-1.36-1.34-1.72-1.34-1.72-1.09-.73.08-.72.08-.72 1.2.08 1.84 1.21 1.84 1.21 1.07 1.79 2.81 1.27 3.5.97.11-.76.42-1.27.76-1.56-2.67-.3-5.47-1.3-5.47-5.79 0-1.28.47-2.33 1.24-3.15-.13-.3-.54-1.5.12-3.13 0 0 1.01-.32 3.3 1.2a11.6 11.6 0 016.01 0c2.29-1.52 3.3-1.2 3.3-1.2.66 1.63.25 2.83.12 3.13.77.82 1.24 1.87 1.24 3.15 0 4.5-2.81 5.49-5.49 5.78.43.36.82 1.09.82 2.2v3.26c0 .32.21.69.82.57A12.01 12.01 0 0024 12.29C24 5.78 18.63.5 12 .5z"/></svg>
      </a>
      <a
        href="mailto:bobchen184@gmail.com"
        aria-label="Email"
        class="flex-1 flex items-center justify-center py-3 text-white/60 hover:text-black hover:bg-[var(--color-neub-yellow)] transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="1"/><path d="m2 6 10 7L22 6"/></svg>
      </a>
    </div>

    <!-- 主題切換 -->
    <div class="px-3 py-3 border-b-2 border-white/15 sidebar-theme">
      <ThemeSwitch />
    </div>

    <!-- 版權 -->
    <div class="px-4 py-3 text-[10px] font-mono uppercase tracking-widest text-white/30">
      © 2026 YC · ALL RIGHTS RESERVED
    </div>
  </div>
</nav>
)}

<!-- ============ md+ : 左側固定全高「淺底」垂直側欄（variant=light，對齊 blog-index 目標） ============ -->
{variant === 'light' && (
<nav
  class="site-sidebar hidden md:flex md:flex-col fixed left-0 top-0 z-40 h-screen bg-[var(--color-neub-bg)] text-[var(--color-ink)] border-r-[3px] border-black"
  aria-label="主要導覽"
>
  <!-- Logo 區：YAN CHEN 大字 + .APP 黃條 -->
  <a
    href={withBase('/')}
    class="block px-4 pt-5 pb-4 border-b-2 border-black/15 hover:opacity-90 transition-opacity"
    aria-label="回到首頁"
  >
    <span class="block font-black tracking-tighter leading-[0.92] text-3xl">YAN<br />CHEN</span>
    <span class="mt-2 inline-block bg-[var(--color-neub-yellow)] border-2 border-black px-2 py-0.5 font-mono text-[11px] font-black uppercase tracking-widest">
      YAN CHEN.APP
    </span>
  </a>

  <!-- 頭像 + 身分 -->
  <div class="flex items-center gap-3 px-4 py-4 border-b-2 border-black/15">
    <img
      src={withBase('/images/logo-mark.png')}
      alt="Yan Chen 自畫像"
      width="48"
      height="48"
      loading="lazy"
      decoding="async"
      class="w-12 h-12 shrink-0 bg-[var(--color-neub-yellow)] border-2 border-black object-cover"
    />
    <span class="min-w-0 leading-tight">
      <span class="block text-sm font-black tracking-tight">Yan Chen</span>
      <span class="block text-[11px] text-[var(--color-ink-60)] mt-0.5">AI Lecturer /<br />Senior Backend Engineer</span>
    </span>
  </div>

  <!-- NAVIGATION 標題 -->
  <div class="px-4 pt-4 pb-1 flex items-center gap-2">
    <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-[var(--color-ink-60)]">navigation</span>
    <span class="flex-1 h-px bg-black/15"></span>
  </div>

  <!-- 導覽列（outline icon，無編號） -->
  <div class="flex-1 flex flex-col gap-0.5 px-2 py-1 text-sm overflow-y-auto neub-scrollbar">
    {
      navItems.map((item, i) => (
        <a
          href={resolveHref(item.href)}
          class:list={[
            'flex items-center gap-3 px-3 py-2.5 border-2 transition-colors',
            isActive(item.href)
              ? 'bg-[var(--color-neub-yellow)] text-black border-black font-black'
              : 'border-transparent text-[var(--color-ink)] hover:bg-black/[0.04] hover:border-black/15',
          ]}
        >
          <span class="shrink-0 inline-flex items-center justify-center w-5 h-5" aria-hidden="true" set:html={navIcons[i]} />
          <span class="tracking-wide">{item.label}</span>
        </a>
      ))
    }
  </div>

  <!-- 訂閱框 + 社群 + 版權 -->
  <div class="px-3 pb-3 pt-2 border-t-2 border-black/15">
    <!-- 訂閱最新文章 -->
    <div class="border-2 border-black bg-[var(--color-paper)] px-3 py-3 shadow-[3px_3px_0_0_#000]">
      <div class="text-[13px] font-black tracking-tight mb-0.5">訂閱最新文章</div>
      <div class="text-[11px] text-[var(--color-ink-60)] mb-2.5 leading-snug">每週一篇技術筆記與觀點</div>
      <form action="https://yanchen.app/#contact" class="flex items-stretch border-2 border-black bg-white">
        <input
          type="email"
          placeholder="輸入你的 Email"
          aria-label="訂閱 Email"
          class="min-w-0 flex-1 px-2.5 py-1.5 text-[12px] bg-transparent outline-none placeholder:text-black/40"
        />
        <button type="submit" aria-label="訂閱" class="shrink-0 bg-black text-white px-2.5 flex items-center justify-center hover:bg-[var(--color-neub-yellow)] hover:text-black transition-colors">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
    </div>

    <!-- 社群 icon 列 -->
    <div class="flex items-center gap-4 px-1 pt-3.5 pb-1">
      <a href="https://github.com/yanchen184" target="_blank" rel="noopener" aria-label="GitHub" class="text-[var(--color-ink-60)] hover:text-black transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.25.82-.57v-2c-3.34.71-4.04-1.58-4.04-1.58-.55-1.36-1.34-1.72-1.34-1.72-1.09-.73.08-.72.08-.72 1.2.08 1.84 1.21 1.84 1.21 1.07 1.79 2.81 1.27 3.5.97.11-.76.42-1.27.76-1.56-2.67-.3-5.47-1.3-5.47-5.79 0-1.28.47-2.33 1.24-3.15-.13-.3-.54-1.5.12-3.13 0 0 1.01-.32 3.3 1.2a11.6 11.6 0 016.01 0c2.29-1.52 3.3-1.2 3.3-1.2.66 1.63.25 2.83.12 3.13.77.82 1.24 1.87 1.24 3.15 0 4.5-2.81 5.49-5.49 5.78.43.36.82 1.09.82 2.2v3.26c0 .32.21.69.82.57A12.01 12.01 0 0024 12.29C24 5.78 18.63.5 12 .5z"/></svg>
      </a>
      <a href="https://www.linkedin.com/" target="_blank" rel="noopener" aria-label="LinkedIn" class="text-[var(--color-ink-60)] hover:text-black transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 110-4.14 2.07 2.07 0 010 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
      </a>
      <a href="https://yanchen.app/rss.xml" aria-label="RSS" class="text-[var(--color-ink-60)] hover:text-black transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 17.82a2.18 2.18 0 11-4.36 0 2.18 2.18 0 014.36 0zM2 9.1v2.9c4.97 0 9 4.03 9 9h2.9C13.9 14.43 8.57 9.1 2 9.1zm0-5.6v2.9C9.46 6.4 15.6 12.54 15.6 20h2.9C18.5 11.1 11.4 4 2 3.5z"/></svg>
      </a>
    </div>

    <!-- 版權 -->
    <div class="px-1 pt-3 mt-2 border-t-2 border-black/10 text-[10px] font-mono uppercase tracking-widest text-[var(--color-ink-60)] leading-relaxed">
      © 2026 YC<br />ALL RIGHTS RESERVED.
    </div>
  </div>
</nav>
)}

<!-- ============ <md : 頂部 sticky bar + hamburger（純 CSS、無 JS） ============ -->
<nav
  class="md:hidden sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b-[3px] border-black"
  aria-label="主要導覽"
>
  <div class="px-4 py-2.5 flex items-center gap-2">
    <a
      href={withBase('/')}
      class="flex items-center gap-2 font-black tracking-tight px-1 py-1 transition-colors"
      aria-label="回到首頁"
    >
      <span
        class="w-9 h-9 inline-flex items-center justify-center bg-[var(--color-neub-yellow)] border-2 border-black text-black font-black text-[15px] tracking-tighter leading-none"
        aria-hidden="true"
      >YC</span>
      <span class="text-sm font-mono lowercase tracking-tight">yanchen.app</span>
    </a>

    <!-- 立即聯繫 CTA（對齊目標圖手機頂 bar） -->
    <a
      href={resolveHref('/#contact')}
      class="ml-auto inline-flex items-center bg-[var(--color-neub-yellow)] border-2 border-black px-3 py-2 text-[12px] font-mono font-black uppercase tracking-wider hover:-translate-y-0.5 transition-transform"
    >
      立即聯繫
    </a>

    <!-- hamburger -->
    <details class="mobile-menu" aria-label="開啟選單">
      <summary
        class="list-none cursor-pointer select-none w-10 h-10 inline-flex items-center justify-center border-2 border-black bg-white hover:bg-[var(--color-neub-yellow)] relative z-50"
        aria-label="切換導覽選單"
      >
        <span class="hamburger-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>

      <div class="mobile-menu-panel fixed left-0 right-0 bg-white border-t-2 border-black z-40 overflow-y-auto" style="top: 60px; height: calc(100vh - 60px);">
        <div class="px-6 py-4 border-b-2 border-black sidebar-theme flex items-center justify-between">
          <span class="text-[11px] font-mono uppercase tracking-widest opacity-60">style</span>
          <ThemeSwitch />
        </div>
        <ul class="flex flex-col font-mono">
          {
            navItems.map((item, i) => (
              <li class="border-b-2 border-black">
                <a
                  href={resolveHref(item.href)}
                  class:list={[
                    'flex items-center gap-3 px-6 py-5 text-base uppercase tracking-widest font-black transition-colors',
                    isActive(item.href)
                      ? 'bg-black text-white'
                      : 'hover:bg-[var(--color-neub-yellow)]',
                  ]}
                >
                  <span class="text-xs opacity-40 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                  <span class="flex-1">{item.label}</span>
                  <span aria-hidden="true" class="text-xl opacity-60">→</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="px-6 py-8 text-xs uppercase tracking-widest font-mono opacity-60">
          © 2026 YC · AI lecturer
        </div>
      </div>
    </details>
  </div>
</nav>

<!-- ============ <md : 底部固定 icon 導覽列（對齊 target mobile 排版） ============ -->
<nav
  class="mobile-bottom-nav md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white border-t-[3px] border-black grid grid-cols-5"
  aria-label="底部導覽"
>
  {
    [
      { label: '首頁', href: '/', icon: 'M3 11.5 12 4l9 7.5M5 10v10h14V10' },
      { label: '作品', href: '/#portfolio', icon: 'M4 5h16v14H4zM4 9h16M9 5v4' },
      { label: '服務', href: '/#courses', icon: 'M12 3 3 8l9 5 9-5zM3 8v6l9 5 9-5V8' },
      { label: '部落格', href: '/blog', icon: 'M5 4h11l3 3v13H5zM9 9h7M9 13h7M9 17h4' },
      { label: '聯繫', href: '/#contact', icon: 'M2 5h20v14H2zM2 6l10 7 10-7' },
    ].map((item) => (
      <a
        href={resolveHref(item.href)}
        class:list={[
          'flex flex-col items-center justify-center gap-1 py-2 text-[10px] font-mono uppercase tracking-widest transition-colors border-r-2 border-black/10 last:border-r-0',
          isActive(item.href) ? 'bg-[var(--color-neub-yellow)] text-black font-black' : 'text-black/70 hover:bg-[var(--color-neub-yellow)]',
        ]}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={item.icon} />
        </svg>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>

<!-- 側欄寬度 + 主內容讓位（md+ 才推移；手機是頂部 bar 不需推） -->
<style is:global>
  :root {
    --sidebar-w: 230px;
  }
  .site-sidebar {
    width: var(--sidebar-w);
  }
  @media (min-width: 768px) {
    body {
      padding-left: var(--sidebar-w);
    }
  }
  /* 手機：底部固定 nav 高度讓位，避免蓋住內容 */
  @media (max-width: 767px) {
    body {
      padding-bottom: 64px;
    }
  }
  /* 深色 sidebar 內的 ThemeSwitch 反白 */
  .sidebar-theme :is(button, a) {
