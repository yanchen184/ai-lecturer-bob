---
/**
 * Neub 風格 Navbar（SSR 友善、純 CSS 可展開手機選單）。
 * - md+ : 左側固定全高垂直側欄（Logo 在上、連結垂直排、主題切換在下），
 *         主內容由全域 body padding-left 往右讓位。
 * - < md: 頂部 sticky bar，Logo 左、hamburger 右，點開後以 <details> 展開全部連結。
 *         用 <details>/<summary> 無需 JS、鍵盤可存取、有語義。
 * - currentPath 用於高亮 active link
 */
import { withBase, base } from '../lib/url';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  currentPath?: string;
}
const rawPath = Astro.props.currentPath ?? Astro.url.pathname;
const currentPath = rawPath.startsWith(base)
  ? rawPath.slice(base.length) || '/'
  : rawPath;

const navItems = [
  { label: '首頁', href: '/' },
  { label: '作品', href: '/#portfolio' },
  { label: '關於', href: '/#about' },
  { label: '服務', href: '/#courses' },
  { label: '部落格', href: '/blog' },
  { label: '聯繫', href: '/#contact' },
] as const;

const isActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};

const resolveHref = (href: string) =>
  href.startsWith('/#') ? withBase('/') + href.slice(1) : withBase(href);
---

<!-- ============ md+ : 左側固定全高垂直側欄 ============ -->
<nav
  class="site-sidebar hidden md:flex md:flex-col fixed left-0 top-0 z-40 h-screen bg-white/95 backdrop-blur-sm border-r-[3px] border-black"
  aria-label="主要導覽"
>
  <!-- Logo -->
  <a
    href={withBase('/')}
    class="flex items-center gap-2 font-black tracking-tight hover:bg-[var(--color-neub-yellow)] px-4 py-4 border-b-2 border-black transition-colors"
    aria-label="回到首頁"
  >
    <span
      class="w-9 h-9 inline-flex items-center justify-center overflow-hidden bg-[var(--color-neub-yellow)] border-2 border-black shrink-0"
    >
      <img
        src={withBase('/images/logo-mark.png')}
        alt="陳彥彤 YC 頭像"
        width="144"
        height="144"
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </span>
    <span class="text-sm">陳彥彤 YC</span>
  </a>

  <!-- 垂直連結列 -->
  <div class="flex-1 flex flex-col gap-1 p-3 text-sm font-mono overflow-y-auto">
    {
      navItems.map((item) => (
        <a
          href={resolveHref(item.href)}
          class:list={[
            'px-3 py-2.5 uppercase tracking-widest border-2 transition-colors',
            isActive(item.href)
              ? 'bg-black text-white border-black'
              : 'border-transparent hover:border-black hover:bg-[var(--color-neub-yellow)]',
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </div>

  <!-- 底部主題切換 -->
  <div class="p-3 border-t-2 border-black">
    <ThemeSwitch />
  </div>
</nav>

<!-- ============ <md : 頂部 sticky bar + hamburger（純 CSS、無 JS） ============ -->
<nav
  class="md:hidden sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b-[3px] border-black"
  aria-label="主要導覽"
>
  <div class="px-6 py-3 flex items-center">
    <a
      href={withBase('/')}
      class="flex items-center gap-2 font-black tracking-tight hover:bg-[var(--color-neub-yellow)] px-2 py-1 transition-colors"
      aria-label="回到首頁"
    >
      <span
        class="w-9 h-9 inline-flex items-center justify-center overflow-hidden bg-[var(--color-neub-yellow)] border-2 border-black"
      >
        <img
          src={withBase('/images/logo-mark.png')}
          alt="陳彥彤 YC 頭像"
          width="144"
          height="144"
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </span>
      <span class="hidden sm:inline text-sm">陳彥彤 YC</span>
    </a>

    <!-- ThemeSwitch 放在 hamburger 左側 -->
    <div class="ml-auto mr-2">
      <ThemeSwitch />
    </div>

    <!-- hamburger -->
    <details class="mobile-menu" aria-label="開啟選單">
      <summary
        class="list-none cursor-pointer select-none w-10 h-10 inline-flex items-center justify-center border-2 border-black bg-white hover:bg-[var(--color-neub-yellow)] relative z-50"
        aria-label="切換導覽選單"
      >
        <span class="hamburger-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>

      <div class="mobile-menu-panel fixed left-0 right-0 bg-white border-t-2 border-black z-40 overflow-y-auto" style="top: 65px; height: calc(100vh - 65px);">
        <ul class="flex flex-col font-mono">
          {
            navItems.map((item) => (
              <li class="border-b-2 border-black">
                <a
                  href={resolveHref(item.href)}
                  class:list={[
                    'flex items-center justify-between px-6 py-5 text-base uppercase tracking-widest font-black transition-colors',
                    isActive(item.href)
                      ? 'bg-black text-white'
                      : 'hover:bg-[var(--color-neub-yellow)]',
                  ]}
                >
                  <span>{item.label}</span>
                  <span aria-hidden="true" class="text-xl opacity-60">→</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="px-6 py-8 text-xs uppercase tracking-widest font-mono opacity-60">
          © 陳彥彤 · ai lecturer
        </div>
      </div>
    </details>
  </div>
</nav>

<!-- 側欄寬度 + 主內容讓位（md+ 才推移；手機是頂部 bar 不需推） -->
<style is:global>
  :root {
    --sidebar-w: 220px;
  }
  .site-sidebar {
    width: var(--sidebar-w);
  }
  @media (min-width: 768px) {
    body {
      padding-left: var(--sidebar-w);
    }
  }
</style>

<style>
  /* 隱藏 summary 預設三角形 */
  summary::-webkit-details-marker { display: none; }
  summary::marker { display: none; content: ''; }

  /* Hamburger → X 動畫 */
  .hamburger-icon {
    position: relative;
    width: 20px;
    height: 14px;
    display: inline-block;
  }
  .hamburger-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: #000;
    transition: transform 0.2s ease, opacity 0.2s ease, top 0.2s ease;
  }
  .hamburger-icon span:nth-child(1) { top: 0; }
  .hamburger-icon span:nth-child(2) { top: 6px; }
  .hamburger-icon span:nth-child(3) { top: 12px; }

  .mobile-menu[open] .hamburger-icon span:nth-child(1) {
    top: 6px;
    transform: rotate(45deg);
  }
  .mobile-menu[open] .hamburger-icon span:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu[open] .hamburger-icon span:nth-child(3) {
    top: 6px;
    transform: rotate(-45deg);
  }

  /* 展開時防止背景捲動 */
  .mobile-menu[open] ~ * {
    /* no-op, left here for future */
  }
</style>
