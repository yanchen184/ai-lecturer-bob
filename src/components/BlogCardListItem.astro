---
/**
 * Neub 風格列表卡片 — magazine grid。
 *
 * - 有 cover：上圖下文,16:10 比例
 * - 沒 cover：純文字,大標題撐視覺
 * - 熱門文(views >= threshold):右上角 fire badge
 *
 * 保留 data-blog-card / data-category / data-tags / data-title / data-excerpt
 * 給 BlogFilters 篩選用。
 */
import type { BlogPost } from '../lib/firestore';
import { withBase } from '../lib/url';

interface Props {
  post: BlogPost;
  views?: number;
}

const { post, views } = Astro.props;
const cover = post.coverImage;
const formatDate = (d: string) => d.replaceAll('-', '/');
const formatViews = (n: number): string => {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return n.toString();
};
const isHot = (views ?? 0) >= 100;
---

<article
  data-blog-card
  data-category={post.category}
  data-tags={post.tags.join('|')}
  data-title={post.title}
  data-excerpt={post.excerpt}
  class="group border-2 border-black bg-white hover:bg-[var(--color-neub-yellow)] transition-colors relative flex flex-col h-full"
>
  {isHot && views && (
    <div class="absolute -top-2 -right-2 bg-black text-[var(--color-neub-yellow)] px-2 py-1 text-[10px] font-mono font-black border-2 border-black z-10 uppercase tracking-widest">
      🔥 {formatViews(views)}
    </div>
  )}

  <a href={withBase(`/blog/${post.slug}`)} class="block flex-1 flex flex-col">
    {cover && (
      <div class="relative aspect-[16/9] border-b-2 border-black bg-white overflow-hidden">
        <img
          src={withBase(cover)}
          alt={post.title}
          width="400"
          height="225"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      </div>
    )}

    <div class="p-4 md:p-5 flex-1 flex flex-col">
      <div class="text-[10px] uppercase tracking-widest font-mono opacity-60 mb-2 flex flex-wrap items-center gap-x-2">
        <span>{formatDate(post.publishDate)}</span>
        <span class="opacity-40">·</span>
        <span class="font-black">{post.category}</span>
        <span class="opacity-40">·</span>
        <span>{post.readingTime} min</span>
      </div>

      <h3 class:list={[
        'font-black leading-snug tracking-tight mb-2',
        cover ? 'text-base md:text-lg line-clamp-2' : 'text-lg md:text-xl line-clamp-3',
      ]}>
        {post.title}
      </h3>

      <p class:list={[
        'text-xs md:text-sm leading-relaxed opacity-75 mb-3 flex-1',
        cover ? 'line-clamp-2' : 'line-clamp-3',
      ]}>
        {post.excerpt}
      </p>

      <div class="flex flex-wrap gap-1 mt-auto">
        {post.tags.slice(0, 3).map((t) => (
          <span class="px-1.5 py-0.5 text-[10px] uppercase tracking-widest font-mono border border-black/40 bg-white/60">
            {t}
          </span>
        ))}
      </div>
    </div>
  </a>
</article>
