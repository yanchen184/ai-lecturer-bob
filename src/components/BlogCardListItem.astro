---
/**
 * Neub 風格列表卡片。
 * - 有 cover：左 200px 圖 + 右文字（手機改上下）
 * - 沒 cover：純文字單欄，標題撐視覺
 * - Hover：整卡轉黃；cover 區固定白底避免黃打黃
 *
 * 保留 data-blog-card / data-category / data-tags / data-title / data-excerpt
 * 給 BlogFilters 篩選用。
 */
import type { BlogPost } from '../lib/firestore';
import { withBase } from '../lib/url';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const cover = post.coverImage;
const formatDate = (d: string) => d.replaceAll('-', '/');
---

<article
  data-blog-card
  data-category={post.category}
  data-tags={post.tags.join('|')}
  data-title={post.title}
  data-excerpt={post.excerpt}
  class="group border-2 border-black bg-white hover:bg-[var(--color-neub-yellow)] transition-colors"
>
  <a
    href={withBase(`/blog/${post.slug}`)}
    class:list={[
      'block',
      cover && 'md:grid md:grid-cols-[200px_1fr] md:gap-5',
    ]}
  >
    {cover && (
      <div class="aspect-[4/3] md:aspect-auto md:h-full border-b-2 md:border-b-0 md:border-r-2 border-black bg-white overflow-hidden">
        <img
          src={withBase(cover)}
          alt={post.title}
          width="400"
          height="300"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <div class="p-4 md:p-5 flex flex-col justify-center">
      <div class="text-[11px] uppercase tracking-widest font-mono opacity-60 mb-2 flex flex-wrap items-center gap-x-2">
        <span>{formatDate(post.publishDate)}</span>
        <span class="opacity-40">·</span>
        <span class="font-black">{post.category}</span>
        <span class="opacity-40">·</span>
        <span>{post.readingTime} min</span>
      </div>

      <h3 class="text-lg md:text-xl font-black leading-snug tracking-tight mb-2">
        {post.title}
      </h3>

      <p class="text-sm leading-relaxed opacity-80 mb-3 line-clamp-2">
        {post.excerpt}
      </p>

      <div class="flex flex-wrap gap-1.5">
        {post.tags.slice(0, 4).map((t) => (
          <span class="px-1.5 py-0.5 text-[10px] uppercase tracking-widest font-mono border border-black/50 bg-white/60">
            {t}
          </span>
        ))}
      </div>
    </div>
  </a>
</article>
