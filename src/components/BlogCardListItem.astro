---
/**
 * Refined editorial neub 列表卡片 — magazine grid。
 *
 * - 有 cover：上圖(黑框面板)下文,16:10 比例
 * - 沒 cover：純文字,大標題撐視覺
 * - 頂部 meta 軌(編號 + 日期)取代 emoji 角標
 *
 * 保留 data-blog-card / data-category / data-tags / data-title / data-excerpt
 * 給 BlogFilters 篩選用。
 */
import type { BlogPost } from '../lib/firestore';
import { withBase } from '../lib/url';

interface Props {
  post: BlogPost;
  views?: number;
  index?: number;
}

const { post, views, index } = Astro.props;
const cover = post.coverImage;
const formatDate = (d: string) => d.replaceAll('-', '/');
const formatViews = (n: number): string => {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return n.toString();
};
const num = typeof index === 'number' ? String(index + 1).padStart(2, '0') : null;
const hasViews = (views ?? 0) > 0;
---

<article
  data-blog-card
  data-category={post.category}
  data-tags={post.tags.join('|')}
  data-title={post.title}
  data-excerpt={post.excerpt}
  class="group border-2 border-black bg-[var(--color-paper)] relative flex flex-col h-full lift"
>
  <a href={withBase(`/blog/${post.slug}`)} class="block flex-1 flex flex-col min-w-0">
    {/* 頂部 meta 軌：編號 + 日期 + reads */}
    <div class="flex items-center justify-between gap-2 px-4 py-2 border-b-2 border-black bg-[var(--color-sink)] font-mono text-[10px] uppercase tracking-widest">
      <span class="flex items-center gap-2 min-w-0">
        {num && <span class="font-black shrink-0">{num}</span>}
        <span class="opacity-60 truncate">{formatDate(post.publishDate)}</span>
      </span>
      <span class="opacity-60 shrink-0">
        {hasViews ? `${formatViews(views!)} reads` : `${post.readingTime} min`}
      </span>
    </div>

    {cover && (
      <div class="relative aspect-[16/10] border-b-2 border-black bg-[var(--color-sink)] overflow-hidden">
        <img
          src={withBase(cover)}
          alt={post.title}
          width="400"
          height="250"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      </div>
    )}

    <div class="p-4 md:p-5 flex-1 flex flex-col min-w-0">
      <div class="font-mono text-[10px] uppercase tracking-widest mb-2">
        <span class="inline-block bg-[var(--color-neub-yellow)] border-2 border-black px-2 py-0.5 leading-none font-black">
          {post.category}
        </span>
      </div>

      <h3 class:list={[
        'font-black leading-snug tracking-tight mb-2 break-words',
        cover ? 'text-base md:text-lg line-clamp-2' : 'text-lg md:text-xl line-clamp-3',
      ]}>
        {post.title}
      </h3>

      <p class:list={[
        'text-xs md:text-sm leading-relaxed text-[var(--color-ink-60)] mb-3 flex-1 break-words',
        cover ? 'line-clamp-2' : 'line-clamp-3',
      ]}>
        {post.excerpt}
      </p>

      <div class="flex flex-wrap gap-1.5 mt-auto">
        {post.tags.slice(0, 3).map((t) => (
          <span class="px-1.5 py-0.5 text-[10px] uppercase tracking-widest font-mono border border-black/30 bg-[var(--color-sink)] text-[var(--color-ink-60)] max-w-full truncate">
            {t}
          </span>
        ))}
      </div>
    </div>
  </a>
</article>
