---
/**
 * Neub 風格 featured hero（黃底 + 黑邊 + 厚陰影 + Most Read badge）。
 * 必須保留 data-blog-featured 給 BlogFilters 用（搜尋時要隱藏）。
 */
import type { BlogPost } from '../lib/firestore';
import { withBase } from '../lib/url';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const cover = post.coverImage;
const formatDate = (d: string) => d.replaceAll('-', '/');
---

<section
  data-blog-featured
  class="relative border-2 border-black bg-[var(--color-neub-yellow)] mb-10"
  style="box-shadow: 8px 8px 0 #0a0a0a;"
>
  <div class="absolute -top-3 left-4 bg-black text-[var(--color-neub-yellow)] px-3 py-1 text-[11px] uppercase tracking-widest font-mono font-black border-2 border-black">
    ★ Most Read · 最多人讀
  </div>

  <a
    href={withBase(`/blog/${post.slug}`)}
    class="grid grid-cols-1 md:grid-cols-2 gap-0 group"
  >
    {cover && (
      <div class="aspect-[4/3] md:aspect-auto border-b-2 md:border-b-0 md:border-r-2 border-black bg-white overflow-hidden">
        <img
          src={withBase(cover)}
          alt={post.title}
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <div class={cover ? 'p-6 md:p-8 flex flex-col justify-center' : 'p-8 md:p-12'}>
      <div class="text-[11px] uppercase tracking-widest font-mono mb-3 flex flex-wrap items-center gap-x-2">
        <span class="font-black">{formatDate(post.publishDate)}</span>
        <span class="opacity-40">·</span>
        <span>{post.category}</span>
        <span class="opacity-40">·</span>
        <span>{post.readingTime} min read</span>
      </div>

      <h2 class="text-3xl md:text-4xl font-black leading-tight tracking-tight mb-4">
        {post.title}
      </h2>

      <p class="text-sm md:text-base leading-relaxed mb-5 opacity-90">
        {post.excerpt}
      </p>

      <div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest font-black font-mono border-b-2 border-black self-start">
        Read the essay →
      </div>
    </div>
  </a>
</section>
