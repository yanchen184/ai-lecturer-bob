---
/**
 * Garden 風格 featured hero（Maggie Appleton 式）
 *
 * 設計取向：
 * - 有 cover：左圖（4:3）右文
 * - 沒 cover：單欄全寬文字，加引言式裝飾框（避免大塊空白色塊）
 * - serif 標題、無厚陰影、無黑邊、"Most Read" eyebrow
 *
 * 必須保留 data-blog-featured 給 BlogFilters 用（搜尋時要隱藏）。
 */
import type { BlogPost } from '../lib/firestore';
import { withBase } from '../lib/url';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const formatDate = (d: string) => {
  const [y, m, day] = d.split('-');
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const idx = parseInt(m, 10) - 1;
  return `${months[idx] ?? m} ${parseInt(day, 10)}, ${y}`;
};
const cover = post.coverImage;
const hasCover = Boolean(cover);
---

<section
  data-blog-featured
  class:list={['garden-hero', !hasCover && 'garden-hero--text-only']}
>
  {hasCover && (
    <a
      href={withBase(`/blog/${post.slug}`)}
      class="garden-hero__cover"
      aria-label={post.title}
    >
      <img
        src={withBase(cover!)}
        alt={post.title}
        loading="eager"
        decoding="async"
      />
    </a>
  )}

  <div>
    <div class="garden-eyebrow" style="margin-bottom: 0.5rem; color: var(--color-garden-crimson);">
      ★ Most Read · 最多人讀
    </div>

    <div class="garden-meta" style="margin-bottom: 0.875rem;">
      <span>{formatDate(post.publishDate)}</span>
      <span style="margin: 0 0.5rem; opacity: 0.5;">·</span>
      <span>{post.category}</span>
      <span style="margin: 0 0.5rem; opacity: 0.5;">·</span>
      <span>{post.readingTime} min read</span>
    </div>

    <h2 class="garden-hero__title">
      <a href={withBase(`/blog/${post.slug}`)} style="color: inherit; text-decoration: none;">
        {post.title}
      </a>
    </h2>

    <p class="garden-hero__excerpt">{post.excerpt}</p>

    <a href={withBase(`/blog/${post.slug}`)} class="garden-hero__cta">
      Read the essay →
    </a>
  </div>
</section>
