---
/**
 * Refined editorial neub featured hero — 暖紙底 + 3px 黑邊 + 克制硬陰影。
 *
 * 兩種版面:
 * - 有 cover：左圖(黑框面板)右文,右欄 mono eyebrow + 黃 chips + marker 標題
 * - 沒 cover：單欄全寬,靠大標題與 marker 撐視覺
 *
 * 必須保留 data-blog-featured 給 BlogFilters 用(搜尋時要隱藏)。
 */
import type { BlogPost } from '../lib/firestore';
import { withBase } from '../lib/url';

interface Props {
  post: BlogPost;
  views?: number;
}

const { post, views } = Astro.props;
const cover = post.coverImage;
const formatDate = (d: string) => d.replaceAll('-', '/');
const formatViews = (n: number): string => {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`;
  return n.toString();
};
---

<section
  data-blog-featured
  class="relative border-[3px] border-black bg-[var(--color-paper)] shadow-hard-lg mb-12 lift"
>
  <a
    href={withBase(`/blog/${post.slug}`)}
    class:list={[
      'block group',
      cover && 'md:grid md:grid-cols-[1.05fr_1fr] md:gap-0',
    ]}
  >
    {cover && (
      <div class="relative aspect-[16/10] md:aspect-auto md:h-full border-b-[3px] md:border-b-0 md:border-r-[3px] border-black bg-[var(--color-sink)] overflow-hidden">
        <img
          src={withBase(cover)}
          alt={post.title}
          loading="eager"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </div>
    )}

    <div class:list={[
      'flex flex-col justify-center relative bg-[var(--color-sink)]',
      cover ? 'p-6 md:p-8 lg:p-10' : 'p-8 md:p-12',
    ]}>
      <div class="flex items-center justify-between gap-3 mb-5">
        <span class="eyebrow">Most Read · 最多人讀</span>
        {views && views > 0 && (
          <span class="font-mono text-[11px] font-black uppercase tracking-widest opacity-70 whitespace-nowrap">
            {formatViews(views)} reads
          </span>
        )}
      </div>

      <div class="flex flex-wrap items-center gap-2 mb-5 font-mono text-[11px] uppercase tracking-widest font-black">
        <span class="bg-[var(--color-neub-yellow)] border-2 border-black px-2.5 py-1 leading-none">
          {post.category}
        </span>
        <span class="bg-[var(--color-neub-yellow)] border-2 border-black px-2.5 py-1 leading-none">
          {formatDate(post.publishDate)}
        </span>
        <span class="border-2 border-black px-2.5 py-1 leading-none">
          {post.readingTime} min read
        </span>
      </div>

      <h2 class:list={[
        'font-black leading-[1.08] tracking-tight mb-4',
        cover ? 'text-2xl md:text-3xl lg:text-[2.5rem]' : 'text-3xl md:text-5xl lg:text-6xl',
      ]}>
        <span class="mark-yellow box-decoration-clone">{post.title}</span>
      </h2>

      <p class:list={[
        'leading-relaxed mb-6 text-[var(--color-ink-60)]',
        cover ? 'text-sm md:text-base line-clamp-3' : 'text-base md:text-lg max-w-3xl line-clamp-4',
      ]}>
        {post.excerpt}
      </p>

      <span class="inline-flex items-center gap-2 text-xs uppercase tracking-widest font-black font-mono bg-black text-[var(--color-neub-yellow)] border-2 border-black px-4 py-2 self-start transition-colors group-hover:bg-[var(--color-neub-yellow)] group-hover:text-black">
        Read the essay →
      </span>
    </div>
  </a>
</section>
