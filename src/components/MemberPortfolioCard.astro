---
/**
 * 會員專區卡片 — 對齊 blog 三欄 magazine grid 卡片風格。
 *
 * - 上圖(黑框面板，16:10)下文(標題 + 摘要)
 * - 不可點(整個專區共用一個登入解鎖，不做單篇路由)
 * - 露出封面圖 + 標題 + 摘要吃 SEO；全文鎖在 D1，由頁面底部的大 gate 登入後解鎖
 */
import type { PublicPost } from '../lib/members-api';

interface Props {
  post: PublicPost;
}

const { post } = Astro.props;
const formatDate = (ms: number) =>
  new Date(ms).toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replaceAll('/', '/');
const tags = post.tags ? post.tags.split(',').map((t) => t.trim()).filter(Boolean) : [];
---

<article
  class="group border-2 border-black bg-[var(--color-paper)] relative flex flex-col h-full"
  style="box-shadow: 4px 4px 0 #0a0a0a"
>
  {post.cover && (
    <div class="relative aspect-[16/10] border-b-2 border-black bg-[var(--color-sink)] overflow-hidden">
      <img
        src={post.cover}
        alt={post.title}
        width="400"
        height="250"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
  )}

  <div class="p-3 md:p-4 flex-1 flex flex-col min-w-0">
    <div class="flex items-center justify-between gap-2 font-mono text-[10px] uppercase tracking-widest mb-2 text-[var(--color-ink-60)]">
      <span class="inline-block bg-[var(--color-neub-yellow)] border-2 border-black px-2 py-0.5 leading-none font-black shrink-0 text-[var(--color-ink)]">
        作品
      </span>
      <span class="truncate">{formatDate(post.created_at)}</span>
    </div>

    <h3 class="font-black leading-snug tracking-tight mb-1.5 break-words text-base md:text-lg line-clamp-2">
      {post.title}
    </h3>

    <p class="text-xs md:text-sm leading-relaxed text-[var(--color-ink-60)] mb-2.5 flex-1 break-words line-clamp-3">
      {post.excerpt}
    </p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-auto">
        {tags.slice(0, 3).map((t) => (
          <span class="px-1.5 py-0.5 text-[10px] uppercase tracking-widest font-mono border border-black/30 bg-[var(--color-sink)] text-[var(--color-ink-60)] max-w-full truncate">
            {t}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
