---
/**
 * /blog/[slug] — 單篇文章頁。
 * SSG：build 時從 Firestore 生成所有文章靜態頁。
 */
import RootLayout from '../../layouts/RootLayout.astro';
import NavbarNeub from '../../components/NavbarNeub.astro';
import FooterNeub from '../../components/FooterNeub.astro';
import BlogStyleSwitcher from '../../components/BlogStyleSwitcher.tsx';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { getAllPublishedPosts, type BlogPost } from '../../lib/firestore';
import { renderMarkdown } from '../../lib/markdown';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getAllPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: BlogPost;
  allPosts: BlogPost[];
}

const { post, allPosts } = Astro.props;

const { html, toc } = renderMarkdown(post.content);

// 相關文章：先依 tag 重疊度排序，同類別補齊，最後最新文章填滿到 3 篇
const related = (() => {
  const currentTags = new Set(post.tags);
  const scored = allPosts
    .filter((p) => p.id !== post.id)
    .map((p) => ({
      post: p,
      tagMatches: p.tags.filter((t) => currentTags.has(t)).length,
      sameCategory: p.category === post.category,
    }));

  const byTag = scored
    .filter((s) => s.tagMatches > 0)
    .sort((a, b) => {
      if (b.tagMatches !== a.tagMatches) return b.tagMatches - a.tagMatches;
      return b.post.publishDate.localeCompare(a.post.publishDate);
    })
    .map((s) => s.post);

  const byCat = scored
    .filter((s) => s.sameCategory && !byTag.some((p) => p.id === s.post.id))
    .map((s) => s.post);

  const combined = [...byTag, ...byCat];
  if (combined.length >= 3) return combined.slice(0, 3);

  const latest = scored
    .filter((s) => !combined.some((p) => p.id === s.post.id))
    .map((s) => s.post)
    .sort((a, b) => b.publishDate.localeCompare(a.publishDate));

  return [...combined, ...latest].slice(0, 3);
})();

const formatDate = (d: string) => d.replaceAll('-', '/');
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const absoluteUrl = (p: string) => `${siteOrigin}${withBase(p)}`;

const postUrl = absoluteUrl(`/blog/${post.slug}`);
const homeUrl = absoluteUrl('/');
const blogUrl = absoluteUrl('/blog');

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  url: postUrl,
  datePublished: post.publishDate,
  dateModified: post.updateDate ?? post.publishDate,
  author: {
    '@type': 'Person',
    name: post.author,
    url: homeUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'AI 講師陳彥彤YC',
    url: homeUrl,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  keywords: post.tags.join(', '),
  articleSection: post.category,
  wordCount: post.content.length,
  inLanguage: 'zh-Hant',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: '部落格', item: blogUrl },
    { '@type': 'ListItem', position: 3, name: post.title, item: postUrl },
  ],
};
---

<RootLayout
  title={`${post.title} | AI 講師陳彥彤YC`}
  description={post.excerpt}
  canonical={`/blog/${post.slug}`}
  jsonLd={[blogPostingSchema, breadcrumbSchema]}
>
  <ReadingProgress />
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <!-- Breadcrumb + Style Switcher -->
    <nav
      class="px-6 md:px-10 py-3 border-b-2 border-black text-xs uppercase tracking-widest font-mono"
      aria-label="breadcrumb"
    >
      <div class="max-w-5xl mx-auto flex items-center gap-3">
        <div class="flex items-center gap-2 opacity-70 min-w-0 flex-1">
          <a href={withBase('/')} class="hover:bg-[#ffff00] px-1 shrink-0">home</a>
          <span class="shrink-0">/</span>
          <a href={withBase('/blog')} class="hover:bg-[#ffff00] px-1 shrink-0">blog</a>
          <span class="shrink-0">/</span>
          <span class="font-black opacity-100 truncate min-w-0">{post.title}</span>
        </div>
        <div class="shrink-0">
          <BlogStyleSwitcher client:load defaultStyle={post.defaultStyle ?? 'neub'} />
        </div>
      </div>
    </nav>

    <!-- Header -->
    <header class="px-6 md:px-10 py-12 border-b-2 border-black bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-xs uppercase tracking-widest mb-4 opacity-70 flex flex-wrap items-center gap-2 font-mono">
          <span class="font-black">[{post.category}]</span>
          <span>·</span>
          <time datetime={post.publishDate}>{formatDate(post.publishDate)}</time>
          <span>·</span>
          <span>{post.readingTime}min read</span>
          {post.featured && (
            <>
              <span>·</span>
              <span class="font-black bg-[#ffff00] px-1">★ FEATURED</span>
            </>
          )}
        </div>

        <h1
          class="text-3xl md:text-5xl font-black leading-tight tracking-tight mb-6"
        >
          {post.title}
        </h1>

        <p class="text-base md:text-lg leading-relaxed opacity-80 max-w-3xl">
          {post.excerpt}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-2 font-mono">
          <span class="text-xs uppercase tracking-widest opacity-60">by</span>
          <span class="font-black">{post.author}</span>
          <span class="text-xs opacity-50">·</span>
          <div class="flex flex-wrap gap-2">
            {post.tags.map((tag) => (
              <a
                href={withBase(`/blog?tag=${encodeURIComponent(tag)}`)}
                class="text-xs border-2 border-black px-2.5 py-1 hover:bg-[#ffff00] leading-none"
              >
                #{tag}
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- TOC + Content -->
    <div class="px-6 md:px-10 py-14">
      <div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-[220px_1fr]">
        {
          toc.length > 0 && (
            <>
              {/* Mobile: collapsible TOC（預設展開讓讀者一眼看到整篇結構） */}
              <details open class="lg:hidden border-2 border-black bg-white min-w-0">
                <summary class="cursor-pointer list-none px-4 py-3 flex items-center justify-between font-mono text-xs uppercase tracking-widest font-black bg-[var(--color-neub-yellow)] border-b-2 border-black">
                  <span>章節目錄 · {toc.length}</span>
                  <span aria-hidden="true" class="toc-caret">▾</span>
                </summary>
                <ul class="border-t-2 border-black text-xs font-mono">
                  {toc.map((item) => (
                    <li class="border-b border-black/10 last:border-b-0">
                      <a
                        href={`#${item.id}`}
                        data-toc-link={item.id}
                        class="block px-4 py-2 opacity-80 hover:bg-[#ffff00] leading-snug"
                      >
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>

              {/* Desktop: sticky sidebar with scroll-spy */}
              <aside class="hidden lg:block">
                <div class="sticky top-24 text-xs font-mono">
                  <div class="uppercase tracking-widest font-black mb-3 opacity-60">
                    目錄
                  </div>
                  <ul class="space-y-1 border-l-2 border-black/10">
                    {toc.map((item) => (
                      <li>
                        <a
                          href={`#${item.id}`}
                          data-toc-link={item.id}
                          class="toc-link block pl-3 -ml-[2px] py-1 opacity-70 hover:opacity-100 hover:bg-[#ffff00] leading-snug transition-all"
                        >
                          {item.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </aside>
            </>
          )
        }

        <article data-blog-prose class="blog-prose min-w-0" set:html={html} />
      </div>
    </div>

    <style is:global>
      .toc-link.is-active {
        opacity: 1;
        font-weight: 900;
        background: #ffeb3b;
        border-left: 2px solid #0a0a0a;
        margin-left: -2px;
        padding-left: 0.75rem;
      }
    </style>

    <script is:inline>
      (function () {
        function init() {
          const links = document.querySelectorAll('[data-toc-link]');
          if (!links.length) return;
          const map = new Map();
          links.forEach((a) => {
            const id = a.getAttribute('data-toc-link');
            const target = document.getElementById(id);
            if (target) map.set(id, { link: a, target });
          });
          if (!map.size) return;

          const setActive = (id) => {
            map.forEach((v, key) => {
              v.link.classList.toggle('is-active', key === id);
            });
          };

          const io = new IntersectionObserver(
            (entries) => {
              // 取目前最靠近頂部的那個 visible heading
              const visible = entries
                .filter((e) => e.isIntersecting)
                .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
              if (visible[0]) setActive(visible[0].target.id);
            },
            { rootMargin: '-100px 0px -60% 0px', threshold: [0, 1] },
          );
          map.forEach((v) => io.observe(v.target));
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>

    <!-- Prism.js syntax highlighting (CDN, 不進 bundle) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css"
    />
    <script is:inline src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-core.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>

    <script is:inline>
      /* 程式碼區塊：filename header + copy 按鈕 */
      (function () {
        function init() {
          const pres = document.querySelectorAll('article.blog-prose pre[data-lang]');
          pres.forEach((pre) => {
            if (pre.dataset.codeEnhanced) return;
            pre.dataset.codeEnhanced = '1';

            const lang = pre.dataset.lang || 'code';
            const filename = pre.dataset.filename || '';
            const label = filename || lang;

            // wrap pre in .code-block
            const wrap = document.createElement('div');
            wrap.className = 'code-block';
            pre.parentNode.insertBefore(wrap, pre);
            wrap.appendChild(pre);

            // header: label + copy btn
            const header = document.createElement('div');
            header.className = 'code-block-header';
            const labelEl = document.createElement('span');
            labelEl.className = 'code-block-label';
            labelEl.textContent = label;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'code-block-copy';
            btn.setAttribute('aria-label', '複製程式碼');
            btn.textContent = 'copy';
            btn.addEventListener('click', async () => {
              const code = pre.querySelector('code')?.innerText ?? '';
              try {
                await navigator.clipboard.writeText(code);
                btn.textContent = 'copied ✓';
                btn.classList.add('is-copied');
                setTimeout(() => {
                  btn.textContent = 'copy';
                  btn.classList.remove('is-copied');
                }, 1600);
              } catch {
                btn.textContent = 'failed';
                setTimeout(() => (btn.textContent = 'copy'), 1600);
              }
            });
            header.appendChild(labelEl);
            header.appendChild(btn);
            wrap.insertBefore(header, pre);
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>

    <script is:inline>
      /* 幫會橫向 overflow 的 table / pre 加提示，依元素類型用不同文案 */
      (function () {
        const LABELS = {
          table: { idle: '← 左右滑動看完整表格 →', end: '← 滑回表格開頭' },
          pre: { idle: '← 左右滑動看程式碼 →', end: '← 回到程式碼開頭' },
        };
        function decorate() {
          const targets = document.querySelectorAll('article.blog-prose table, article.blog-prose pre');
          targets.forEach((el) => {
            if (el.dataset.scrollHinted) return;
            if (el.scrollWidth <= el.clientWidth + 1) return;
            const kind = el.tagName === 'TABLE' ? 'table' : 'pre';
            const labels = LABELS[kind];
            const hint = document.createElement('div');
            hint.className = 'scroll-hint';
            hint.setAttribute('aria-hidden', 'true');
            hint.textContent = labels.idle;
            // 若 pre 被 .code-block 包起來，把 hint 插在 wrapper 前面；否則插在 el 前
            const anchor = el.closest('.code-block') || el;
            anchor.parentNode.insertBefore(hint, anchor);
            el.dataset.scrollHinted = '1';

            const update = () => {
              const atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 2;
              hint.classList.toggle('at-end', atEnd);
              hint.textContent = atEnd ? labels.end : labels.idle;
            };
            update();
            el.addEventListener('scroll', update, { passive: true });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', decorate);
        } else {
          decorate();
        }
        window.addEventListener('resize', decorate, { passive: true });
      })();
    </script>

    <!-- Author + Share -->
    <section class="px-6 md:px-10 py-12 border-t-2 border-black bg-white">
      <div class="max-w-5xl mx-auto grid gap-6 md:grid-cols-2">
        <div>
          <div class="text-xs uppercase tracking-widest mb-2 opacity-60 font-mono">
            author
          </div>
          <div class="flex items-start gap-3">
            <div
              class="w-12 h-12 bg-[var(--color-neub-yellow)] border-2 border-black flex items-center justify-center font-black"
            >
              陳
            </div>
            <div>
              <div class="font-black">{post.author}</div>
              <p class="text-sm opacity-70 leading-relaxed">
                後端工程師 · AI 講師。Spring Boot / React / MySQL / Redis。
              </p>
            </div>
          </div>
        </div>
        <div>
          <div class="text-xs uppercase tracking-widest mb-2 opacity-60 font-mono">
            support
          </div>
          <p class="text-sm opacity-80 leading-relaxed">
            覺得文章有用可以到 GitHub 給個 star，或是透過信箱聊聊企業內訓、技術諮詢。
          </p>
          <div class="mt-3 flex flex-wrap gap-2 font-mono">
            <a
              href="mailto:bobchen184@gmail.com"
              class="px-3 py-1.5 text-xs uppercase tracking-widest border-2 border-black hover:bg-[#ffff00]"
              >email</a
            >
            <a
              href="https://github.com/yanchen184"
              target="_blank"
              rel="noopener"
              class="px-3 py-1.5 text-xs uppercase tracking-widest border-2 border-black hover:bg-[#ffff00]"
              >github</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- Related Posts -->
    {
      related.length > 0 && (
        <section class="px-6 md:px-10 py-14 border-t-2 border-black">
          <div class="max-w-5xl mx-auto">
            <div class="text-xs uppercase tracking-widest opacity-60 mb-2 font-mono">
              related
            </div>
            <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-6">
              相關文章
            </h2>
            <div class="grid gap-0 md:grid-cols-3 border-t-2 border-black">
              {related.map((r, i) => (
                <a
                  href={withBase(`/blog/${r.slug}`)}
                  class:list={[
                    'block p-4 border-b-2 border-black hover:bg-[#ffff00] transition-colors',
                    i < 2 ? 'md:border-r-2' : '',
                  ]}
                >
                  <div class="text-xs uppercase tracking-widest opacity-60 mb-2 font-mono">
                    [{r.category}] · {r.readingTime}min
                  </div>
                  <div class="font-black leading-tight mb-2">{r.title}</div>
                  <div class="text-xs opacity-70 line-clamp-2">{r.excerpt}</div>
                </a>
              ))}
            </div>
            <div class="mt-6 text-center">
              <a
                href={withBase('/blog')}
                class="inline-block px-4 py-2 text-xs uppercase tracking-widest border-2 border-black hover:bg-[#ffff00] font-mono"
                >← all posts</a
              >
            </div>
          </div>
        </section>
      )
    }
  </main>

  <FooterNeub />

  <div id="__post_meta" data-slug={post.slug} data-title={post.title} hidden></div>
  <script>
    import { trackPostView } from '../../lib/firebase-client';
    const el = document.getElementById('__post_meta') as HTMLElement | null;
    const slug = el?.dataset.slug ?? '';
    const title = el?.dataset.title ?? '';
    if (slug) {
      const fire = () => { void trackPostView(slug, title); };
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(fire, { timeout: 2000 });
      } else {
        setTimeout(fire, 1200);
      }
    }
  </script>
</RootLayout>
