---
/**
 * /style — 設計風格目錄頁。
 *
 * 原 Vite 專案有 5 個完整主題頁（swiss-modernism / bento-box / bold-typography /
 * aurora / liquid-glass），每個約 600 行 React + CSS。遷到 Astro SSG 時考量：
 * - 實際使用率低（訪客主要看 blog 跟首頁）
 * - 每個主題都是重度 Framer Motion / 視差效果，純 SSG 難還原
 * - 不符合「不要過度設計」原則
 *
 * 所以這裡改做一個 catalog 頁介紹這些美學範本，搭配精美卡片展示設計語言。
 * 真要展示某個主題的完整動態效果，可以保留舊 Vite 專案做為 demo。
 */
import RootLayout from '../../layouts/RootLayout.astro';
import NavbarNeub from '../../components/NavbarNeub.astro';
import FooterNeub from '../../components/FooterNeub.astro';
import { withBase } from '../../lib/url';

interface Theme {
  id: string;
  name: string;
  nameZh: string;
  tagline: string;
  description: string;
  palette: string[];
  gradient: string;
  keywords: string[];
  textColor: string;
}

const themes: Theme[] = [
  {
    id: 'swiss-modernism',
    name: 'Neubrutalism',
    nameZh: '新野獸派',
    tagline: '粗框色塊、硬派陰影、大膽搶眼',
    description:
      '高對比黑白骨架 + 螢光色塊的 Gen Z 視覺語言。厚 2px 邊框、錯位陰影、monospace 字體排列，帶有 90s Web 的粗獷感。本站首頁採用的正是這個系統。',
    palette: ['#FFEB3B', '#FF5252', '#2196F3', '#0A0A0A'],
    gradient: 'linear-gradient(135deg, #FFEB3B, #FF5252, #2196F3)',
    keywords: ['Bold', 'Monospace', 'High-contrast', 'Off-grid'],
    textColor: '#0A0A0A',
  },
  {
    id: 'bento-box',
    name: 'Nature Distilled',
    nameZh: '自然提煉',
    tagline: '大地色調、有機質感、手作溫暖',
    description:
      '木紋、米白、苔綠層次疊合的手作美感。適合需要放鬆、溫暖、親近感的教育型產品。字體選用圓潤襯線 + 小型手寫元素，留白大方。',
    palette: ['#C67B5C', '#D4C4A8', '#6B7B3C', '#3F3A30'],
    gradient: 'linear-gradient(135deg, #C67B5C, #D4C4A8, #6B7B3C)',
    keywords: ['Organic', 'Earthy', 'Serif', 'Warm'],
    textColor: '#FFFFFF',
  },
  {
    id: 'bold-typography',
    name: 'Motion-Driven',
    nameZh: '動態敘事',
    tagline: '流暢轉場、視覺敘事、場景切換',
    description:
      '以 Framer Motion 動畫貫穿整個首頁體驗，滑鼠滾輪觸發場景轉場。深色基底 + 高飽和漸層強調視覺焦點，適合作品集或 Launch Page 使用。',
    palette: ['#6366F1', '#EC4899', '#F59E0B', '#111111'],
    gradient: 'linear-gradient(135deg, #6366F1, #EC4899, #F59E0B)',
    keywords: ['Motion', 'Gradient', 'Dark', 'Cinematic'],
    textColor: '#FFFFFF',
  },
  {
    id: 'aurora',
    name: 'Parallax Storytelling',
    nameZh: '視差敘事',
    tagline: '章節式滾動、電影級沉浸體驗',
    description:
      '以章節為單位的視差滾動設計，每個 section 都是一個視覺場景。深紫藍基底配霓虹紅點綴，字體使用襯線體強化文學感。適合長篇故事型內容。',
    palette: ['#1a1a2e', '#16213e', '#0f3460', '#e94560'],
    gradient: 'linear-gradient(135deg, #1a1a2e, #16213e, #0f3460, #e94560)',
    keywords: ['Parallax', 'Serif', 'Narrative', 'Immersive'],
    textColor: '#FFFFFF',
  },
  {
    id: 'liquid-glass',
    name: 'Anti-Polish / Raw',
    nameZh: '反修飾原生',
    tagline: '手繪質感、紙張肌理、真實不修飾',
    description:
      '刻意反對「pixel perfect」的設計哲學，採用噪點、手繪線條、紙張紋理。強調真實、粗糙、原創。適合個人部落格或獨立藝術家網站。',
    palette: ['#FAFAF8', '#C4A77D', '#4A4A4A', '#1F1F1F'],
    gradient: 'linear-gradient(135deg, #FAFAF8, #C4A77D, #4A4A4A)',
    keywords: ['Raw', 'Hand-drawn', 'Texture', 'Anti-design'],
    textColor: '#1F1F1F',
  },
];

const currentStyleId = 'swiss-modernism';
---

<RootLayout
  title="設計風格目錄 — AI 講師陳彥彤YC"
  description="五種 2025 前端設計語言範本展示：Neubrutalism、Nature Distilled、Motion-Driven、Parallax Storytelling、Anti-Polish。"
  canonical="/style"
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <!-- Hero -->
    <section class="px-6 md:px-10 py-16 md:py-24 border-b-2 border-black bg-white">
      <div class="max-w-6xl mx-auto">
        <div
          class="inline-block px-2 py-1 mb-6 text-xs uppercase tracking-widest border-2 border-black font-black bg-[var(--color-neub-yellow)] font-mono"
        >
          style lab · 5 themes
        </div>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-6 leading-none">
          設計風格<br />
          <span class="bg-[var(--color-neub-yellow)] px-3">範本庫</span>
        </h1>
        <p class="text-base md:text-lg opacity-80 leading-relaxed max-w-3xl">
          收錄 5 種 2025 前端設計語言，對應不同產品氣質與品牌調性。
          本站主視覺採用 Neubrutalism，其它幾款作為設計教材與風格參考。
          若有企業內訓 / 形象網站改版需求，可以挑選喜歡的風格當作溝通起點。
        </p>
      </div>
    </section>

    <!-- Themes Grid -->
    <section class="px-6 md:px-10 py-14 bg-[#FAFAFA]">
      <div class="max-w-6xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
          themes · 共 5 款
        </div>
        <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-10">
          風格一覽
        </h2>

        <div class="grid gap-6 md:grid-cols-2">
          {
            themes.map((theme, idx) => (
              <article
                class:list={[
                  'group border-2 border-black bg-white overflow-hidden',
                  idx === themes.length - 1 && themes.length % 2 === 1
                    ? 'md:col-span-2'
                    : '',
                ]}
                style="box-shadow: 6px 6px 0 #0a0a0a;"
              >
                <div
                  class="relative h-44 md:h-56 border-b-2 border-black flex items-end p-5"
                  style={`background: ${theme.gradient};`}
                >
                  <div class="flex items-center gap-2 flex-wrap">
                    {theme.palette.map((c) => (
                      <span
                        class="w-9 h-9 border-2 border-black shadow-[2px_2px_0_rgba(0,0,0,0.6)]"
                        style={`background: ${c};`}
                        aria-hidden="true"
                      />
                    ))}
                  </div>
                  <span
                    class="absolute top-3 right-3 text-[10px] uppercase tracking-widest font-black px-2 py-0.5 bg-white border-2 border-black font-mono"
                  >
                    {theme.id === currentStyleId ? 'active' : 'preview'}
                  </span>
                </div>

                <div class="p-5 md:p-6">
                  <div class="text-xs uppercase tracking-widest opacity-60 mb-1 font-mono">
                    {theme.nameZh}
                  </div>
                  <h3 class="text-xl md:text-2xl font-black tracking-tight mb-2">
                    {theme.name}
                  </h3>
                  <p class="text-sm font-mono opacity-70 mb-4">{theme.tagline}</p>
                  <p class="text-sm leading-relaxed opacity-80 mb-4">
                    {theme.description}
                  </p>
                  <div class="flex flex-wrap gap-1.5">
                    {theme.keywords.map((k) => (
                      <span class="text-[11px] font-mono uppercase tracking-wider border border-black px-1.5 py-0.5">
                        #{k}
                      </span>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-6 md:px-10 py-14 border-t-2 border-black bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
          want a custom site?
        </div>
        <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-4">
          想要自己的設計系統？
        </h2>
        <p class="text-base opacity-80 leading-relaxed max-w-3xl mb-6">
          企業內訓 / 形象網站改版 / React Design System 建置，歡迎直接聯繫討論。
          這些風格都可以當作起點，再依品牌調性客製色彩、字體、動態細節。
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="mailto:bobchen184@gmail.com"
            class="px-5 py-3 text-sm uppercase tracking-widest font-black bg-[var(--color-neub-yellow)] border-2 border-black font-mono hover:bg-black hover:text-white transition-colors"
            style="box-shadow: 4px 4px 0 #0a0a0a;"
          >
            → email 洽詢
          </a>
          <a
            href={withBase('/blog')}
            class="px-5 py-3 text-sm uppercase tracking-widest font-black bg-white border-2 border-black font-mono hover:bg-[var(--color-neub-yellow)] transition-colors"
            style="box-shadow: 4px 4px 0 #0a0a0a;"
          >
            → 看技術文章
          </a>
          <a
            href={withBase('/')}
            class="px-5 py-3 text-sm uppercase tracking-widest font-black bg-white border-2 border-black font-mono hover:bg-[var(--color-neub-yellow)] transition-colors"
            style="box-shadow: 4px 4px 0 #0a0a0a;"
          >
            → 回首頁
          </a>
        </div>
      </div>
    </section>
  </main>

  <FooterNeub />
</RootLayout>
