---
/**
 * /admin — 後台資訊頁（noindex）。
 *
 * 發文流程已改用 `/ig-create` Claude Code skill（本地端觸發 Firestore 寫入
 * 後，gh workflow run 重建站台）。訪客統計、留言、聯絡表單等資料直接在
 * Firebase Console 查看，不另外在 SSG 站實作介面。
 */
import RootLayout from '../layouts/RootLayout.astro';
import NavbarNeub from '../components/NavbarNeub.astro';
import FooterNeub from '../components/FooterNeub.astro';
import { withBase } from '../lib/url';

const consoleBase = 'https://console.firebase.google.com/project/forbidden-beauty';
const links = [
  {
    label: '文章集合（bob_blog_posts）',
    desc: '查看 / 編輯所有文章，或把 published 設為 false 下架',
    href: `${consoleBase}/firestore/data/~2Fbob_blog_posts`,
  },
  {
    label: '聯絡訊息（contacts）',
    desc: '首頁聯絡表單寫入的資料',
    href: `${consoleBase}/firestore/data/~2Fcontacts`,
  },
  {
    label: '訪客統計（visits）',
    desc: 'Analytics 替代方案：每次訪問的 UA / referrer',
    href: `${consoleBase}/firestore/data/~2Fvisits`,
  },
  {
    label: '留言板（messages）',
    desc: '公開留言，在 Firestore 修改後立即生效',
    href: `${consoleBase}/firestore/data/~2Fmessages`,
  },
  {
    label: 'GitHub Actions — Deploy',
    desc: '手動觸發重建、查看 build 狀態',
    href: 'https://github.com/yanchen184/ai-lecturer-bob/actions/workflows/deploy.yml',
  },
  {
    label: 'GitHub Pages 設定',
    desc: 'Pages source / custom domain 設定',
    href: 'https://github.com/yanchen184/ai-lecturer-bob/settings/pages',
  },
];
---

<RootLayout
  title="Admin — AI 講師陳彥彤YC"
  description="Admin — 本站後台資訊頁。"
  canonical="/admin"
  noindex={true}
>
  <NavbarNeub />

  <main class="font-sans text-[#0a0a0a]">
    <section class="px-6 md:px-10 py-16 border-b-2 border-black bg-white">
      <div class="max-w-5xl mx-auto">
        <div
          class="inline-block px-2 py-1 mb-6 text-xs uppercase tracking-widest border-2 border-black font-black bg-[var(--color-neub-yellow)] font-mono"
        >
          private · noindex
        </div>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4">
          Admin
        </h1>
        <p class="text-base md:text-lg opacity-80 leading-relaxed max-w-2xl">
          本站為 Astro 靜態站，後台管理介面已改由 Firebase Console 直接操作。
          下方整理常用入口，點擊後會開啟對應的雲端控制台（需要登入 Google 帳號）。
        </p>
      </div>
    </section>

    <section class="px-6 md:px-10 py-16 bg-[#FAFAFA]">
      <div class="max-w-5xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
          quick access
        </div>
        <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-8">
          常用連結
        </h2>

        <div class="grid gap-4 md:grid-cols-2">
          {
            links.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group border-2 border-black bg-white p-5 hover:bg-[var(--color-neub-yellow)] transition-colors"
                style="box-shadow: 4px 4px 0 #0a0a0a;"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <div class="font-black text-base leading-tight mb-1">
                      {l.label}
                    </div>
                    <div class="text-sm opacity-70 leading-relaxed">
                      {l.desc}
                    </div>
                  </div>
                  <span class="text-xl opacity-60 group-hover:opacity-100 transition-opacity">
                    ↗
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="px-6 md:px-10 py-14 border-t-2 border-black bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-xs uppercase tracking-widest opacity-60 mb-3 font-mono">
          publish workflow
        </div>
        <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-6">
          發文流程
        </h2>

        <ol class="space-y-3 text-sm md:text-base leading-relaxed">
          <li class="flex gap-3">
            <span class="font-black font-mono min-w-[2rem]">01.</span>
            <span>
              在 Claude Code 輸入 <code class="bg-black text-white px-1.5 py-0.5 rounded font-mono text-xs">/ig-create</code> 並給出主題
            </span>
          </li>
          <li class="flex gap-3">
            <span class="font-black font-mono min-w-[2rem]">02.</span>
            <span>Skill 會自動生成 IG 貼文 + 部落格長文，並寫入 Firestore（published=true）</span>
          </li>
          <li class="flex gap-3">
            <span class="font-black font-mono min-w-[2rem]">03.</span>
            <span>
              Skill 最後會執行 <code class="bg-black text-white px-1.5 py-0.5 rounded font-mono text-xs">gh workflow run deploy.yml</code> 重建站台
            </span>
          </li>
          <li class="flex gap-3">
            <span class="font-black font-mono min-w-[2rem]">04.</span>
            <span>等 ~1 分鐘 GitHub Actions 跑完，新文章就上線了</span>
          </li>
        </ol>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={withBase('/blog')}
            class="px-5 py-3 text-sm uppercase tracking-widest font-black bg-white border-2 border-black font-mono hover:bg-[var(--color-neub-yellow)] transition-colors"
            style="box-shadow: 4px 4px 0 #0a0a0a;"
          >
            → 看前台 Blog
          </a>
          <a
            href={withBase('/')}
            class="px-5 py-3 text-sm uppercase tracking-widest font-black bg-white border-2 border-black font-mono hover:bg-[var(--color-neub-yellow)] transition-colors"
            style="box-shadow: 4px 4px 0 #0a0a0a;"
          >
            → 回首頁
          </a>
        </div>
      </div>
    </section>
  </main>

  <FooterNeub />
</RootLayout>
